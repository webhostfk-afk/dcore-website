content  block-dynamic\">\n                <div class=\"module-features-description\">\n      <ul>\n                  <li>Model: FD3041T</li>\n                  <li>4 ports EPON PON card for EPON OLT E08EP-4S+</li>\n                  <li>Warranty: 2 Years</li>\n              </ul>\n</div>\n\n              </div>\n              <div class=\"block-footer\"><a class=\"btn\" href=\"#\">View Details</a></div>\n          </div>\n  </div>\n\n      </div>\n                    </div>\n</div>\n\n                  </div>\n                              </div>\n            </div>\n                  </div>\n                      </div>\n      </div>\n\n                                </div>\n                                                </div>","blocksHtml":"<div class=\"product-blocks blocks-default\">\n            <div class=\"product-blocks-default product-blocks-416 grid-rows\">\n          <div class=\"grid-row grid-row-416-1\">\n                <div class=\"grid-cols\">\n                      <div class=\"grid-col grid-col-416-1-1\">\n              <div class=\"grid-items\">\n                                  <div class=\"grid-item grid-item-416-1-1-1\">\n                    <div class=\"module module-blocks module-blocks-417 blocks-tabs\">\n    <div class=\"module-body\">\n                <div class=\"tabs-container\">\n      <ul class=\"nav nav-tabs\">\n                  <li class=\"tab-2 active\">\n                          <a href=\"#blocks-6afefafb5e2f8-tab-1\" data-toggle=\"tab\">Description</a>\n                      </li>\n                  <li class=\"tab-4\">\n                          <a href=\"#blocks-6afefafb5e2f8-tab-2\" data-toggle=\"tab\">Product Table</a>\n                      </li>\n                  <li class=\"tab-5\">\n                          <a href=\"#blocks-6afefafb5e2f8-tab-3\" data-toggle=\"tab\">Video</a>\n                      </li>\n                  <li class=\"tab-6\">\n                          <a href=\"#blocks-6afefafb5e2f8-tab-4\" data-toggle=\"tab\">Review</a>\n                      </li>\n              </ul>\n      <div class=\"tab-content\">\n                              <div class=\"module-item module-item-2 tab-pane active\" id=\"blocks-6afefafb5e2f8-tab-1\">\n                  <div class=\"block-body expand-block\">\n            <div class=\"block-wrapper\">\n      <div class=\"block-content  block-description\">\n                <div><h2><b>ECOM FD3041T OLT EPON 4 Ports PON Card</b></h2><span style=\"font-size: 14px;\">The ECOM FD3041T is a 4-port EPON Optical Line Terminal (OLT) expansion module designed for FTTH (Fiber to the Home) networks. Manufactured by C-Data, this module enhances the FD1304E-B1 OLT by adding four EPON SFP ports, allowing for increased scalability and service delivery capacity.​</span></div><div><br></div><h3><span style=\"font-size: 16px;\"><b>Key Features:</b></span></h3><ul><li><span style=\"font-size: 14px; font-family: Poppins;\">PON Ports: 4 SFP slots supporting EPON (IEEE 802.3ah) standards.</span></li><li><span style=\"font-family: Poppins; font-size: 14px;\">Transmission Distance: Up to 20 km using single-mode fiber (9/125μm SMF).</span></li><li><span style=\"font-family: Poppins; font-size: 14px;\">Data Rate: Symmetrical 1.25 Gbps upstream and downstream.</span></li><li><span style=\"font-family: Poppins; font-size: 14px;\">Wavelengths: 1490 nm for downstream (transmit) and 1310 nm for upstream (receive).</span></li><li><span style=\"font-family: Poppins; font-size: 14px;\">Splitting Ratio: Supports a maximum of 1:64, facilitating efficient bandwidth distribution.</span></li><li><span style=\"font-family: Poppins; font-size: 14px;\">Optical Power: Transmit power ranges from +2.5 to +7 dBm; receive sensitivity is ≤ -27 dBm.</span></li><li><span style=\"font-family: Poppins; font-size: 14px;\">Power Supply: Operates on 100-240V AC with dual redundant power supply options.</span></li><li><span style=\"font-family: Poppins; font-size: 14px;\">Management: Supports SNMP, Telnet, CLI, and Web-based management for comprehensive network control.</span></li></ul>\n              </div>\n          </div>\n  </div>\n\n            </div>\n                                        <div class=\"module-item module-item-4 tab-pane no-expand\" id=\"blocks-6afefafb5e2f8-tab-2\">\n                  <div class=\"block-body expand-block\">\n            <div class=\"block-wrapper\">\n      <div class=\"block-content  block-dynamic\">\n                           \n\n              </div>\n          </div>\n  </div>\n\n            </div>\n                                        <div class=\"module-item module-item-5 tab-pane no-expand\" id=\"blocks-6afefafb5e2f8-tab-3\">\n                  <div class=\"block-body expand-block\">\n            <div class=\"block-wrapper\">\n      <div class=\"block-content  block-dynamic\">\n                    \n\n\n              </div>\n          </div>\n  </div>\n\n            </div>\n                                        <div class=\"module-item module-item-6 tab-pane\" id=\"blocks-6afefafb5e2f8-tab-4\">\n                  <div class=\"block-body expand-block\">\n            <div class=\"block-wrapper\">\n      <div class=\"block-content  block-reviews\">\n                <form class=\"form-horizontal\" id=\"form-review\">\n  <div id=\"review\"><p>There are no reviews for this product.</p> </div>\n  <h4>Write a review</h4>\n        <div class=\"form-group required\">\n      <label class=\"col-sm-2 control-label\" for=\"input-name\">Your Name</label>\n      <div class=\"col-sm-10\">\n        <input type=\"text\" name=\"name\" value=\"\" id=\"input-name\" class=\"form-control\">\n      </div>\n    </div>\n    <div class=\"form-group required\">\n      <label class=\"col-sm-2 control-label\" for=\"input-review\">Your Review</label>\n      <div class=\"col-sm-10\">\n        <textarea name=\"text\" rows=\"5\" id=\"input-review\" class=\"form-control\"></textarea>\n        <div class=\"help-block\"><span class=\"
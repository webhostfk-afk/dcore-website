ol-448-1-1\">\n              <div class=\"grid-items\">\n                                  <div class=\"grid-item grid-item-448-1-1-1\">\n                    <div class=\"module module-blocks module-blocks-460 blocks-grid\">\n    <div class=\"module-body\">\n              <div class=\"module-item module-item-1\">\n            <div class=\"block-body expand-block\">\n          <h3 class=\"title module-title block-title\">Key Features</h3>\n            <div class=\"block-wrapper\">\n      <div class=\"block-content  block-dynamic\">\n                <div class=\"module-features-description\">\n      <ul>\n                  <li>Model: GPNA11</li>\n                  <li>PON Port: 1 × GPON SC/APC</li>\n                  <li>LAN Port: 1 × 10/100/1000Mbps RJ45</li>\n                  <li>GPON Standard: ITU-T G.984.x</li>\n                  <li>Optical Wavelength: TX 1310nm / RX 1490nm</li>\n                  <li>Maximum Transmission Distance: Up to 20 km</li>\n                  <li>Network Features: VLAN, QoS, IGMP Snooping</li>\n                  <li>Power Supply: DC 12V</li>\n                  <li>Warranty: 01 Year</li>\n              </ul>\n</div>\n\n              </div>\n              <div class=\"block-footer\"><a class=\"btn\" href=\"#\">View Details</a></div>\n          </div>\n  </div>\n\n      </div>\n                    </div>\n</div>\n\n                  </div>\n                              </div>\n            </div>\n                  </div>\n                      </div>\n      </div>\n\n                                </div>\n                                                </div>","blocksHtml":"<div class=\"product-blocks blocks-default\">\n            <div class=\"product-blocks-default product-blocks-416 grid-rows\">\n          <div class=\"grid-row grid-row-416-1\">\n                <div class=\"grid-cols\">\n                      <div class=\"grid-col grid-col-416-1-1\">\n              <div class=\"grid-items\">\n                                  <div class=\"grid-item grid-item-416-1-1-1\">\n                    <div class=\"module module-blocks module-blocks-417 blocks-tabs\">\n    <div class=\"module-body\">\n                <div class=\"tabs-container\">\n      <ul class=\"nav nav-tabs\">\n                  <li class=\"tab-2 active\">\n                          <a href=\"#blocks-6afefafb5e2f8-tab-1\" data-toggle=\"tab\">Description</a>\n                      </li>\n                  <li class=\"tab-4\">\n                          <a href=\"#blocks-6afefafb5e2f8-tab-2\" data-toggle=\"tab\">Product Table</a>\n                      </li>\n                  <li class=\"tab-5\">\n                          <a href=\"#blocks-6afefafb5e2f8-tab-3\" data-toggle=\"tab\">Video</a>\n                      </li>\n                  <li class=\"tab-6\">\n                          <a href=\"#blocks-6afefafb5e2f8-tab-4\" data-toggle=\"tab\">Review</a>\n                      </li>\n              </ul>\n      <div class=\"tab-content\">\n                              <div class=\"module-item module-item-2 tab-pane active\" id=\"blocks-6afefafb5e2f8-tab-1\">\n                  <div class=\"block-body expand-block\">\n            <div class=\"block-wrapper\">\n      <div class=\"block-content  block-description\">\n                <p>The KingType GPNA11 GPON ONU is a compact and reliable Fiber-to-the-Home (FTTH) optical network unit designed to provide high-speed broadband connectivity for residential and small business users. Fully compliant with ITU-T G.984.x GPON standards, it ensures seamless compatibility with most GPON OLT platforms, making it an ideal solution for Internet Service Providers (ISPs) and enterprise fiber deployments.</p><p><br></p><p>Featuring 1 Gigabit Ethernet (10/100/1000Mbps) LAN port, the GPNA11 delivers fast and stable wired network performance for routers, PCs, IP cameras, IPTV, VoIP, and smart home devices. It supports OMCI remote management, VLAN, QoS, multicast, and advanced security functions, enabling efficient network management and reliable broadband service.</p><p><br></p><p>Its compact design, low power consumption, and plug-and-play installation make the KingType GPNA11 GPON ONU an excellent choice for FTTH, FTTB, and FTTO applications requiring dependable fiber connectivity.</p><p><br></p><h3>Key Features</h3><p><br></p><ul><li>1 × GPON Optical Port</li><li>1 × Gigabit Ethernet (10/100/1000Mbps) RJ45 Port</li><li>ITU-T G.984.x GPON Standard</li><li>OMCI Remote Management</li><li>VLAN &amp; QoS Support</li><li>IGMP Snooping for IPTV</li><li>High-Speed FTTH Broadband Access</li><li>Low Power Consumption</li><li>Compact Desktop Design</li><li>Easy Installation and Configuration</li></ul>\n              </div>\n          </div>\n  </div>\n\n            </div>\n                                        <div class=\"module-item module-item-4 tab-pane\" id=\"blocks-6afefafb5e2f8-tab-2\">\n                  <div class=\"block-body expand-block\">\n            <div class=\"block-wrapper\">\n      <div class=\"block-content  block-dynamic\">\n                <div class=\"module-compatibility-table\" id=\"tab-compatibility\">\n            <h3>Product List</h3>\n        <div class=\"module-compatibility-table-content\">\n      \n        <div class=\"table-responsive\">\n          <table class=\"table table-bordered\">\n            <thead>\n                <tr>\n                  <td class=\"compatibility-table-name\"><strong></strong></td>\n                  <td class=\"compatibility-table-price\"><strong>Price</strong></td>\n                </tr>\n            </thead>\n            <tbody>\n                                <tr>    \n                    <td class=\"compatibility-table-name\"><a href=\"/xpon-onu-with-2ge-and-dual-band-wifi-fd512gd-r550\">XPON ONU with 2GE &amp; Dual Band WiFi FD512GD-R550</a></td>\n                    <td class=\"compatibility-table-price\">\n                        <p class=\"price\"> \n                             \n                       
"/image/cache/catalog/Deepcool/LS720S%20ZERO%20DARK/LS720S-ZERO-DARK_P5-80x80.jpg.webp","alt":"DeepCool LS720S ZERO DARK 360mm Liquid CPU Cooler","width":80,"height":80}],"labels":[{"out":false,"text":"-6 %"}],"banner":{"href":null,"image":{"src":"/image/cache/catalog/Slider%20Image/DCORE-Home-delivery-1040x200.jpg.webp","alt":"Home Delivery","width":0,"height":0}},"title":"DeepCool LS720S ZERO DARK 360mm Liquid CPU Cooler","stats":[{"cls":"","label":"","value":"Special Price : 11,700৳","href":null,"plain":true},{"cls":"","label":"","value":"Regular Price : 12,500৳","href":null,"plain":true},{"cls":"","label":"","value":"Product ID : 355","href":null,"plain":true},{"cls":"product-stock in-stock","label":"Status:","value":"In Stock","href":null,"plain":false},{"cls":"product-manufacturer","label":"Brands:","value":"DeepCool","href":"/deepcool","plain":false},{"cls":"product-model","label":"Model:","value":"LS720S ZERO DARK","href":null,"plain":false}],"minimum":"","price":{"new":"11,700৳","old":"12,500৳","single":"","tax":"Ex Tax: 11,700৳","discounts":[]},"request":false,"askText":"","stepperHidden":false,"productId":"355","features":{"title":"Key Features","items":[{"h":"Model:  LS720S ZERO DARK","c":[]},{"h":"Socket Support: Intel LGA1700/1200/1151/1150/1155, AMD AM5/AM4","c":[]},{"h":"Fan Dimensions: 120×120×25mm (L×W×H)","c":[]},{"h":"Radiator Material: Aluminum","c":[]},{"h":"Fan Noise: ≤32.9 dB(A)","c":[]},{"h":"Fan Speed: 500~1600 RPM±10%","c":[]},{"h":"Fan Airflow: 60.85 CFM","c":[]},{"h":"Bearing Type: Hydro Bearing","c":[]},{"h":"3-Year Limited Warranty","c":[]}],"noExpand":false},"tabs":[{"title":"Description","active":true,"cls":"tab-2","noExpand":false,"kind":"description","html":"\n                <h3 data-start=\"191\" data-end=\"248\"><strong data-start=\"195\" data-end=\"248\">DeepCool LS720S ZERO DARK 360mm Liquid CPU Cooler</strong></h3>\n<p data-start=\"250\" data-end=\"610\">The DeepCool LS720S ZERO DARK is a high-performance 360mm all-in-one liquid CPU cooler designed for powerful cooling with a clean, stealthy look. Featuring DeepCool’s 4th-Generation water pump, anti-leak technology, and three high-efficiency PWM fans, this AIO cooler ensures quiet operation and maximum thermal performance for modern Intel and AMD processors.</p>\n<h4 data-start=\"612\" data-end=\"634\"><strong data-start=\"617\" data-end=\"634\">Key Features:</strong></h4>\n<ul data-start=\"635\" data-end=\"1300\"><li data-start=\"635\" data-end=\"753\">\n<p data-start=\"637\" data-end=\"753\"><strong data-start=\"639\" data-end=\"669\">All-Black ZERO DARK Design</strong> – A sleek matte-black finish with subtle lighting for a minimalist, stealthy setup.</p>\n</li><li data-start=\"754\" data-end=\"876\">\n<p data-start=\"756\" data-end=\"876\"><strong data-start=\"758\" data-end=\"787\">4th Generation Water Pump</strong> – Advanced cooling engine with optimized microchannels and 3-phase motor up to 3100 RPM.</p>\n</li><li data-start=\"877\" data-end=\"984\">\n<p data-start=\"879\" data-end=\"984\"><strong data-start=\"881\" data-end=\"920\">360mm Radiator with Triple PWM Fans</strong> – Delivers superior airflow and static pressure with low noise.</p>\n</li><li data-start=\"985\" data-end=\"1100\">\n<p data-start=\"987\" data-end=\"1100\"><strong data-start=\"989\" data-end=\"1013\">Anti-Leak Technology</strong> – Automatically balances internal pressure to reduce risk of leaks and enhance safety.</p>\n</li><li data-start=\"1101\" data-end=\"1193\">\n<p data-start=\"1103\" data-end=\"1193\"><strong data-start=\"1105\" data-end=\"1132\">Universal Compatibility</strong> – Supports Intel LGA 1700/1200/115x and AMD AM5/AM4 sockets.</p>\n</li><li data-start=\"1194\" data-end=\"1300\">\n<p data-start=\"1196\" data-end=\"1300\"><strong data-start=\"1198\" data-end=\"1227\">Quiet &amp; Durable Operation</strong> – Hydro bearing fans and premium build for long-lasting, silent cooling.</p>\n</li></ul>\n<h4 data-start=\"1302\" data-end=\"1326\"><strong data-start=\"1307\" data-end=\"1326\">Specifications:</strong></h4>\n<ul data-start=\"1327\" data-end=\"1575\"><li data-start=\"1327\" data-end=\"1367\">\n<p data-start=\"1329\" data-end=\"1367\"><strong data-start=\"1329\" data-end=\"1347\">Radiator Size:</strong> 402 x 120 x 27 mm</p>\n</li><li data-start=\"1368\" data-end=\"1404\">\n<p data-start=\"1370\" data-end=\"1404\"><strong data-start=\"1370\" data-end=\"1384\">Fan Speed:</strong> 500~2250 RPM ±10%</p>\n</li><li data-start=\"1405\" data-end=\"1439\">\n<p data-start=\"1407\" data-end=\"1439\"><strong data-start=\"1407\" data-end=\"1419\">Airflow:</strong> 85.85 CFM per fan</p>\n</li><li data-start=\"1440\" data-end=\"1472\">\n<p data-start=\"1442\" data-end=\"1472\"><strong data-start=\"1442\" data-end=\"1458\">Noise Level:</strong> ≤32.9 dB(A)</p>\n</li><li data-start=\"1473\" data-end=\"1506\">\n<p data-start=\"1475\" data-end=\"1506\"><strong data-start=\"1475\" data-end=\"1490\">Pump Speed:</strong> 3100 RPM ±10%</p>\n</li><li data-start=\"1507\" data-end=\"1575\">\n<p data-start=\"1509\" data-end=\"1575\"><strong data-start=\"1509\" data-end=\"1528\">Socket Support:</strong> Intel LGA1700/1200/1151/1150/1155, AMD AM5/AM4</p></li></ul>\n              "},{"title":"Product Table","active":false,"cls":"tab-4","noExpand":false,"kind":"compat","title2":"Product List","head":["","Price"],"rows":[{"name":"Deepcool GAMMAXX AG500 ARGB Cpu Cooler","href":"/deepcool-gammaxx-ag500-argb-cpu-cooler","now":"2,900৳","old":"3,500৳","single":""},{"name":"Deepcool AK500 120mm Single Tower CPU Cooler","href":"/deepcool-ak500-120mm-single-tower-cpu-cooler","now":"5,200৳","old":"5,320৳","single":""},{"name":"Deepcool AK500 WH 120mm Single Tower CPU Cooler","href":"/deepcool-ak500-wh-120mm-single-tower-cpu-cooler","now":"5,500৳","old":"6,320৳","single":""},{"name":"DeepCool AG400 PLUS 120mm CPU cooler","href":"/deepcool-ag400-plus-120mm-cpu-cooler","now":"","old":"","single":"2,800৳"},{"name":"DeepCool AG400 LED 120mm C
rtup without main power</li><li>LED indicators for quick UPS status monitoring</li><li>Overload, surge &amp; short-circuit protection</li><li>Ideal for PCs, routers, CCTV, POS machines, and home electronics</li></ul>\n              "},{"title":"Product Table","active":false,"cls":"tab-4","noExpand":false,"kind":"compat","title2":"Product List","head":["","Price"],"rows":[{"name":"Marsiva MR-UF2000 2000VA Smart Line-Interactive UPS","href":"/marsiva-mr-uf2000-2000va-smart-line-interactive-ups","now":"","old":"","single":"15,500৳"},{"name":"Marsiva MR-UF800 800VA Smart Line Interactive UPS","href":"/marsiva-mr-uf800-80va-offline-ups","now":"","old":"","single":"5,200৳"},{"name":"Marsiva MR-UF650 650VA Smart Line Interactive UPS","href":"/marsiva-mr-uf650-650va-offline-ups","now":"","old":"","single":"4,200৳"}]},{"title":"Video","active":false,"cls":"tab-5","noExpand":true,"kind":"empty"},{"title":"Review","active":false,"cls":"tab-6","noExpand":false,"kind":"review"}],"side":{"title":"From Same Brand","items":[{"href":"/must-eh55-h1k2-1kva-online-ups","image":{"src":"/image/cache/catalog/EH55-H1K2/Must%20EH55-H1K2%201KVA%20Online%20UPS%20P1-100x100.jpg.webp","alt":"Must EH55-H1K2 1KVA Online UPS","width":100,"height":100},"name":"Must EH55-H1K2 1KVA Online UPS","now":"20,000৳","old":"22,100৳","single":"","tax":"Ex Tax:20,000৳","out":true},{"href":"/must-eh55-h1k3-1kva-online-ups","image":{"src":"/image/cache/catalog/EH55-H1K3/Must%20EH55-H1K3%201KVA%20Online%20UPS%20P1-100x100.jpg.webp","alt":"Must EH55-H1K3 1KVA Online UPS","width":100,"height":100},"name":"Must EH55-H1K3 1KVA Online UPS","now":"21,500৳","old":"24,000৳","single":"","tax":"Ex Tax:21,500৳","out":false},{"href":"/must-eh55-h1ks-1kva-online-ups","image":{"src":"/image/cache/catalog/EH55-H1KS/Must%20EH55-H1KS%201KVA%20Online%20UPS%20P1-100x100.jpg.webp","alt":"Must EH55-H1KS 1KVA Online UPS","width":100,"height":100},"name":"Must EH55-H1KS 1KVA Online UPS","now":"29,000৳","old":"31,000৳","single":"","tax"
ef":"/deepcool","plain":false},{"cls":"product-model","label":"Model:","value":"AG400 WH ARGB","href":null,"plain":false}],"minimum":"","price":{"new":"","old":"","single":"3,100৳","tax":"Ex Tax: 3,100৳","discounts":[]},"request":false,"askText":"","stepperHidden":false,"productId":"243","features":{"title":"Key Features","items":[{"h":"Model: GAMMAXX AG400 WH ARGB","c":[]},{"h":"Fan Speed: 500~1850 RPM±10%","c":[]},{"h":"Fan Airflow: 75.89 CFM","c":[]},{"h":"Bearing Type: Hydro Bearing","c":[]},{"h":"Warranty : 1 year","c":[]}],"noExpand":false},"tabs":[{"title":"Description","active":true,"cls":"tab-2","noExpand":false,"kind":"description","html":"\n                <h2>DeepCool GAMMAXX AG400 WH ARGB 120mm CPU Air Cooler – White RGB Performance Cooling</h2><p>Upgrade your PC’s cooling system with the DeepCool GAMMAXX AG400 WH ARGB, a powerful and stylish 120mm CPU air cooler engineered for optimal thermal performance and brilliant addressable RGB lighting. With its all-white finish, four direct-contact heat pipes, and high-performance PWM fan, the AG400 WH ARGB delivers efficient cooling for modern Intel and AMD CPUs—perfect for gamers, content creators, and PC enthusiasts.</p><h3>Key Features:</h3><ul><li><b>Efficient Cooling Performance: </b>Supports up to 220W TDP, making it suitable for mainstream and high-performance CPUs.</li><li><b>Four Heat Pipes with Direct Contact:</b> Maximizes heat transfer from the CPU surface for stable, low temperatures.</li><li><b>120mm PWM Fan: </b>Delivers dynamic airflow up to 75.89 CFM with low noise levels (≤31.6 dB(A)).</li><li><b>ARGB Lighting:</b> Customizable addressable RGB LEDs sync with major motherboard brands via 3-pin 5V connectors.</li><li><b>White Aesthetic:</b> Clean, modern look that complements white-themed PC builds.</li><li><b>Broad Compatibility: </b>Supports Intel LGA1700/1200/115X and AMD AM5/AM4 sockets.</li><li><b>Compact Size:</b> At just 150mm in height, it fits most mid-tower and compact cases without RAM interference.</li></ul>\n              "},{"title":"Product Table","active":false,"cls":"tab-4","noExpand":false,"kind":"compat","title2":"Product List","head":["","Price"],"rows":[{"name":"Deepcool GAMMAXX AG500 ARGB Cpu Cooler","href":"/deepcool-gammaxx-ag500-argb-cpu-cooler","now":"2,900৳","old":"3,500৳","single":""},{"name":"DeepCool LS720S ZERO DARK 360mm Liquid CPU Cooler","href":"/deepcool-ls720s-zero-dark-360mm-liquid-cpu-cooler","now":"11,700৳","old":"12,500৳","single":""},{"name":"Deepcool AK500 120mm Single Tower CPU Cooler","href":"/deepcool-ak500-120mm-single-tower-cpu-cooler","now":"5,200৳","old":"5,320৳","single":""},{"name":"Deepcool AK500 WH 120mm Single Tower CPU Cooler","href":"/deepcool-ak500-wh-120mm-single-tower-cpu-cooler","now":"5,500৳","old":"6,320৳","single":""},{"name":"DeepCool AG400 PLUS 120mm CPU cooler","href":"/deepcool-ag400-plus-120mm-cpu-cooler","now":"","old":"","single":"2,800৳"},{"name":"DeepCool AG400 LED 120mm CPU Cooler","href":"/deepcool-ag400-led-120mm-cpu-cooler","now":"","old":"","single":"2,150৳"},{"name":"DeepCool AG300 Single Tower CPU Cooler","href":"/deepcool-ag300-single-tower-cpu-cooler","now":"","old":"","single":"1,900৳"},{"name":"DeepCool AK400 BK High Performance CPU Air Cooler","href":"/deepcool-ak400-bk-high-performance-cpu-air-cooler","now":"","old":"","single":"3,100৳"},{"name":"Jungle Leopard A200 Plus CPU Cooling FAN","href":"/jungle-leopard-a200-plus-cpu-cooling-fan","now":"","old":"","single":"850৳"},{"name":"DeepCool AG400 BK ARGB 120mm Single Tower CPU Cooler","href":"/deepcool-ag400-bk-argb-120mm-single-tower-cpu-cooler","now":"","old":"","single":"3,000৳"}]},{"title":"Video","active":false,"cls":"tab-5","noExpand":true,"kind":"empty"},{"title":"Review","active":false,"cls":"tab-6","noExpand":false,"kind":"review"}],"side":{"title":"From Same Brand","items":[{"href":"/deepcool-ag300-single-tower-cpu-cooler","image":{"src":"/image/cache/catalog/Deepcool/AG%20300/AG300-500x500-2-100x100.jpg.webp","a
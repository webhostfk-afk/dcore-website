rc":"/image/cache/catalog/Slider%20Image/OTECH-Home-delivery-1040x200.jpg.webp","alt":"Home Delivery","width":0,"height":0}},"title":"Mikrotik RB1100AHx4 13x Gigabit Ports 4 Core 1U Rackmount Ethernet Router","stats":[{"cls":"","label":"","value":"Special Price : 36,000৳","href":null,"plain":true},{"cls":"","label":"","value":"Regular Price : 38,000৳","href":null,"plain":true},{"cls":"","label":"","value":"Product ID : 403","href":null,"plain":true},{"cls":"product-stock out-of-stock","label":"Status:","value":"Out Of Stock","href":null,"plain":false},{"cls":"product-manufacturer","label":"Brands:","value":"MikroTik","href":"/mikrotik","plain":false},{"cls":"product-model","label":"Model:","value":"RB1100AHx4","href":null,"plain":false}],"minimum":"","price":{"new":"36,000৳","old":"38,000৳","single":"","tax":"Ex Tax: 36,000৳","discounts":[]},"request":false,"askText":"","stepperHidden":false,"productId":"403","features":{"title":"Key Features","items":[{"h":"4 Core CPU 1.4 GHz AL21400 ARM 32bit Architecture","c":[]},{"h":"Switch Chip Model: RTL8367","c":[]},{"h":"RouterOS license: 6","c":[]},{"h":"Operating System: RouterOS","c":[]},{"h":"Size of RAM: 1 GB, Storage Size: 128 MB","c":[]},{"h":"Serial console Port: RS232","c":[]},{"h":"Max Power Consumption: 20 W","c":[]},{"h":"AC Inputs: Dual Redundant Power Supply","c":[]},{"h":"Warranty: 1 Year (Limited Warranty)","c":[]}],"noExpand":false},"tabs":[{"title":"Description","active":true,"cls":"tab-2","noExpand":false,"kind":"description","html":"\n                <p data-start=\"758\" data-end=\"1104\">The <strong data-start=\"762\" data-end=\"785\">MikroTik RB1100AHx4</strong> is a <strong data-start=\"791\" data-end=\"823\">powerful 1U rackmount router</strong> featuring <strong data-start=\"834\" data-end=\"863\">13 Gigabit Ethernet ports</strong> and a <strong data-start=\"870\" data-end=\"902\">quad-core ARM Cortex A15 CPU</strong> running at <strong data-start=\"914\" data-end=\"934\">1.4 GHz per core</strong>. Designed for high-throughput environments, it delivers exceptional routing performance of over <strong data-start=\"1031\" data-end=\"1043\">7.5 Gbps</strong> and is ideal for ISPs, corporate networks, and data centers.</p>\n<p data-start=\"1106\" data-end=\"1332\">Equipped with <strong data-start=\"1120\" data-end=\"1140\">1 GB of DDR4 RAM</strong>, <strong data-start=\"1142\" data-end=\"1165\">128 MB NAND storage</strong>, and <strong data-start=\"1171\" data-end=\"1199\">RouterOS Level 6 license</strong>, the RB1100AHx4 offers advanced networking features such as <strong data-start=\"1260\" data-end=\"1316\">firewall, VPN, bandwidth management, MPLS, BGP, OSPF</strong>, and much more.</p>\n<p data-start=\"1334\" data-end=\"1594\">With <strong data-start=\"1339\" data-end=\"1372\">dual redundant power supplies</strong> and <strong data-start=\"1377\" data-end=\"1396\">passive cooling</strong>, it ensures reliable operation even in demanding network environments. It also includes a <strong data-start=\"1487\" data-end=\"1506\">smart card slot</strong>, <strong data-start=\"1508\" data-end=\"1519\">microSD</strong>, and <strong data-start=\"1525\" data-end=\"1537\">M.2 SATA</strong> interface for additional storage or user authentication.</p><h3 data-start=\"1601\" data-end=\"1624\"><strong data-start=\"1607\" data-end=\"1624\">Key Features:</strong></h3>\n<ul data-start=\"1625\" data-end=\"2167\"><li data-start=\"1625\" data-end=\"1650\">\n<p data-start=\"1627\" data-end=\"1650\"><strong data-start=\"1627\" data-end=\"1637\">Model:</strong> RB1100AHx4</p>\n</li><li data-start=\"1651\" data-end=\"1726\">\n<p data-start=\"1653\" data-end=\"1726\"><strong data-start=\"1653\" data-end=\"1661\">CPU:</strong> Annapurna Labs Alpine AL21400 (4-Core, 1.4 GHz ARM Cortex-A15)</p>\n</li><li data-start=\"1727\" data-end=\"1749\">\n<p data-start=\"1729\" data-end=\"1749\"><strong data-start=\"1729\" data-end=\"1737\">RAM:</strong> 1 GB DDR4</p>\n</li><li data-start=\"1750\" data-end=\"1806\">\n<p data-start=\"1752\" data-end=\"1806\"><strong data-start=\"1752\" data-end=\"1764\">Storage:</strong> 128 MB NAND, microSD, and M.2 SATA slot</p>\n</li><li data-start=\"1807\" data-end=\"1852\">\n<p data-start=\"1809\" data-end=\"1852\"><strong data-start=\"1809\" data-end=\"1828\">Ethernet Ports:</strong> 13 x Gigabit Ethernet</p>\n</li><li data-start=\"1853\" data-end=\"1899\">\n<p data-start=\"1855\" data-end=\"1899\"><strong data-start=\"1855\" data-end=\"1871\">Performance:</strong> Up to 7.5 Gbps throughput</p>\n</li><li data-start=\"1900\" data-end=\"1933\">\n<p data-start=\"1902\" data-end=\"1933\"><strong data-start=\"1902\" data-end=\"1918\">Form Factor:</strong> 1U rackmount</p>\n</li><li data-start=\"1934\" data-end=\"1981\">\n<p data-start=\"1936\" data-end=\"1981\"><strong data-start=\"1936\" data-end=\"1946\">Power:</strong> Dual redundant AC power supplies</p>\n</li><li data-start=\"1982\" data-end=\"2042\">\n<p data-start=\"1984\" data-end=\"2042\"><strong data-start=\"1984\" data-end=\"2005\">Operating System:</strong> MikroTik RouterOS, Level 6 License</p>\n</li><li data-start=\"2043\" data-end=\"2101\">\n<p data-start=\"2045\" data-end=\"2101\"><strong data-start=\"2045\" data-end=\"2057\">Cooling:</strong> Passive heatsink with high airflow design</p>\n</li><li data-start=\"2102\" data-end=\"2167\">\n<p data-start=\"2104\" data-end=\"2167\"><strong data-start=\"2104\" data-end=\"2119\">Additional:</strong> Smart card slot, M.2 SATA for storage expansion</p></li></ul><h3 data-start=\"2174\" data-end=\"2196\"><strong data-start=\"2180\" data-end=\"2194\">Ideal For:</strong></h3>\n<ul data-start=\"2197\" data-end=\"2389\"><li data-start=\"2197\" data-end=\"2233\">\n<p data-start=\"2199\" data-end=\"2233\">Internet Service Providers (ISP)</p>\n</li><li data-start=\"2234\" data-end=\"2277\">\n<p data-start=\"2236\" data-end=\"2277\">Enterprise and Data Center Core Routing</p>\n</li><li data-start=\"2278\" data-end=\"2316\">\n<p data-start=\"2280\" data-end=\"2316\">Border Gateway or VPN Concentrator</p>\n</li><li data-start=\"2317\" data-end=\"2354\">\n<p data-start=\"2319\" data-end=\"2354\">Carrier-Grade NAT / Load Balancer</p>\n</li><li data-start=\"2355\" data-end=\"2389\">\n<p data-start=\"2357\" data-end=\"2389\">Firewall and Routing Aggregation</p></li></ul><p data-start=\"1334\" data-end=\"1594\"><br></p><p data-start=\"1334\" data-end=\"1594\"><br></p><p data-start=\"1334\" data-end=\"1594\"><br></p><p><br></p>\n              "},{"title":"Product Table","active":false,"cls":"tab-4","noExpand":false,"kind":"compat","title2":"Product List","head":["","Price"],"rows":[{"name":"Cisco ASR-920-24SZ-M Router","href":"/cisco-asr-920-24sz-m-router","now":"73,000৳","old":"75,000৳","single":""},{"name":"Mikrotik CCR2116-12G-4S+ 16-Core ARM CPU 4x 10G SFP+ Cloud Core Ethernet Router","href":"/mikrotik-ccr2116-12g-4s-16-core-arm-cpu-4x-10g-sfp-cloud-core-ethernet-router","now":"112,000৳","old":"119,000৳","single":""},{"name":"Juniper MX80 Universal Router","href":"/juniper-mx80-universal-router","now":"175,000৳","old":"180,000৳","single":""},{"name":"MikroTik CCR2004-1G-12S+2XS Cloud Core Router","href":"/mikrotik-ccr2004-1g-12s2xs-cloud-core-router","now":"67,000৳","old":"68,000৳","single":""},{"name":"Huawei NetEngine AR720 2x GE WAN Combo Ports 8x GE LAN Ports High-Performance Enterprise Router","href":"/%20huawei-netengine-ar720-2x-ge-wan-combo-ports-8x-ge-lan-ports-high-performance-enterprise-router","now":"85,000৳","old":"90,000৳","single":""},{"name":"Cisco C1111-8P Dual WAN Ethernet Integrated Services Router","href":"/cisco-c1111-8p-dual-wan-ethernet-integrated-services-router","now":"","old":"","single":"95,000৳"}]},{"title":"Video","active":false,"cls":"tab-5","noExpand":true,"kind":"empty"},{"title":"Review","active":false,"cls":"tab-6","noExpand":false,"kind":"review"}],"side":{"title":"From Same Brand","items":[{"href":"/mikrotik-25in-sata-128gb-ssd-legacy-x86-routeros-64bit-licens
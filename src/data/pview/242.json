P support</li><li>ARGB lighting for fully customizable RGB effects</li><li>Sleek matte black finish for clean aesthetics</li><li>120mm PWM fan with Hydro Bearing for silent operation</li><li>Easy installation with secure fan lock mounting system</li><li>Compatible with Intel LGA1700/1200/115x and AMD AM5/AM4</li></ul>\n              "},{"title":"Product Table","active":false,"cls":"tab-4","noExpand":false,"kind":"compat","title2":"Product List","head":["","Price"],"rows":[{"name":"Deepcool GAMMAXX AG500 ARGB Cpu Cooler","href":"/deepcool-gammaxx-ag500-argb-cpu-cooler","now":"2,900৳","old":"3,500৳","single":""},{"name":"DeepCool LS720S ZERO DARK 360mm Liquid CPU Cooler","href":"/deepcool-ls720s-zero-dark-360mm-liquid-cpu-cooler","now":"11,700৳","old":"12,500৳","single":""},{"name":"Deepcool AK500 120mm Single Tower CPU Cooler","href":"/deepcool-ak500-120mm-single-tower-cpu-cooler","now":"5,200৳","old":"5,320৳","single":""},{"name":"Deepcool AK500 WH 120mm Single Tower CPU Cooler","href":"/deepcool-ak500-wh-120mm-single-tower-cpu-cooler","now":"5,500৳","old":"6,320৳","single":""},{"name":"DeepCool AG400 PLUS 120mm CPU cooler","href":"/deepcool-ag400-plus-120mm-cpu-cooler","now":"","old":"","single":"2,800৳"},{"name":"DeepCool AG400 LED 120mm CPU Cooler","href":"/deepcool-ag400-led-120mm-cpu-cooler","now":"","old":"","single":"2,150৳"},{"name":"DeepCool AG300 Single Tower CPU Cooler","href":"/deepcool-ag300-single-tower-cpu-cooler","now":"","old":"","single":"1,900৳"},{"name":"DeepCool AK400 BK High Performance CPU Air Cooler","href":"/deepcool-ak400-bk-high-performance-cpu-air-cooler","now":"","old":"","single":"3,100৳"},{"name":"Jungle Leopard A200 Plus CPU Cooling FAN","href":"/jungle-leopard-a200-plus-cpu-cooling-fan","now":"","old":"","single":"850৳"},{"name":"DeepCool GAMMAXX AG400 WH ARGB 120mm CPU Cooler","href":"/deepcool-gammaxx-ag400-wh-argb-120mm-cpu-cooler","now":"","old":"","single":"3,100৳"}]},{"title":"Video","active":false,"cls":"tab-5","noExpand":true
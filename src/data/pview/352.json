":"7,000৳","tax":"Ex Tax: 7,000৳","discounts":[]},"request":false,"askText":"","stepperHidden":false,"productId":"352","features":{"title":"Key Features","items":[{"h":"Model: PL650D","c":[]},{"h":"Type: ATX12V V3.1","c":[]},{"h":"Output Capacity: 650W","c":[]},{"h":"Fan Size: 120mm Black Fan","c":[]},{"h":"Certifications: 80 PLUS Bronze","c":[]},{"h":"5-Year Limited Warranty","c":[]}],"noExpand":false},"tabs":[{"title":"Specification","active":true,"cls":"tab-1","noExpand":false,"kind":"empty"},{"title":"Description","active":false,"cls":"tab-2","noExpand":false,"kind":"description","html":"\n                <h3 data-start=\"140\" data-end=\"220\"><strong data-start=\"144\" data-end=\"220\">DeepCool PL650D 650W Power Supply – 80 Plus Bronze | Non-Modular ATX 3.0</strong></h3>\n<p data-start=\"222\" data-end=\"554\" style=\"text-align: justify; \">Power up your PC with confidence using the <strong data-start=\"265\" data-end=\"306\">DeepCool PL650D 650 Watt&nbsp;<a href=\"/component/power-supply\" target=\"_blank\" rel=\"noopener noreferrer\">Power Supply</a></strong>, engineered for efficiency, durability, and modern system compatibility. Featuring <strong data-start=\"390\" data-end=\"422\">80 Plus Bronze certification</strong> and <strong data-start=\"427\" data-end=\"449\">ATX 3.0 compliance</strong>, this PSU ensures optimal energy savings and reliable performance for today's high-demand CPUs and GPUs.</p>\n<p data-start=\"556\" data-end=\"835\" style=\"text-align: justify;\">With a <strong data-start=\"563\" data-end=\"585\">non-modular design</strong>, the PL650D offers straightforward installation, making it ideal for budget-conscious builders and stable system configurations. A <strong data-start=\"717\" data-end=\"754\">120mm quiet hydraulic bearing fan</strong> keeps temperatures in check while maintaining low noise levels during operation.</p>\n<p data-start=\"837\" data-end=\"1107\" style=\"text-align: justify;\">The PL650D includes essential safety protections such as <strong data-start=\"894\" data-end=\"925\">OVP, OPP, SCP, OCP, and OTP</strong>, helping to safeguard your components from electrical hazards. Designed with all the necessary connectors for modern systems, it's perfect for gaming, office, or workstation builds.</p><p style=\"text-align: justify;\"><br></p>\n              "},{"title":"Product Table","active":false,"cls":"tab-4","noExpand":false,"kind":"compat","title2":"Product List","head":["","Price"],"rows":[{"name":"DeepCool PL550D 550 Watt Non-Modular 80 Plus Bronze ATX 3.0 Power Supply","href":"/deepcool-pl550d-550-watt-non-modular-80-plus-bronze-atx-30-power-supply","now":"5,900৳","old":"6,000৳","single":""},{"name":"DeepCool PN750D 750W 80 Plus Gold Non-Modular ATX 3.1 Power Supply","href":"/deepcool-pn750d-750w-80-plus-gold-non-modular-atx-31-power-supply","now":"9,500৳","old":"9,800৳","single":""},{"name":"DeepCool PN650D 650W 80 Plus Gold Non-Modular ATX 3.1 Power Supply","href":"/deepcool-pn650d-650w-80-plus-gold-non-modular-atx-31-power-supply","now":"8,250৳","old":"8,800৳","single":""},{"name":"Corsair CV550 550 Watt 80 Plus Bronze Certified Non-Modular ATX Power Supply","href":"/corsair-cv550-550-watt-80-plus-bronze-certified-non-modular-atx-power-supply","now":"5,200৳","old":"5,700৳","single":""},{"name":"Dell D750E-S6 750W Power Supply","href":"/dell-d750e-s6-750w-power-supply","now":"6,000৳","old":"7,500৳","single":""},{"name":"DeepCool PN850M 850W 80 Plus Gold Full-Modular ATX 3.1 Power Supply","href":"/deepcool-pn850m-850w-80-plus-gold-full-modular-atx-31-power-supply","now":"","old":"","single":"14,300৳"},{"name":"DeepCool PK650D 650 Watt 80 PLUS Bronze Power Supply","href":"/deepcool-pk650d-650-watt-80-plus-bronze-power-supply","now":"","old":"","single":"7,300৳"},{"name":"DeepCool PN750M 750W 80 Plus Gold Full-Modular ATX 3.1 Power Supply","href":"/deepcool-pn750m-750w-80-plus-gold-full-modular-atx-31-power-supply","now":"","old":"","single":"12,600৳"},{"name":"DeepCool PK750D
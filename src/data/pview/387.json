"image":{"src":"/image/cache/catalog/Slider%20Image/DCORE-Home-delivery-1040x200.jpg.webp","alt":"Home Delivery","width":0,"height":0}},"title":"Cambium Networks ePMP 1000 2.4GHz Integrated 150Mbps Radio with Built-in 12dBi Antenna","stats":[{"cls":"","label":"","value":"Special Price : 12,000৳","href":null,"plain":true},{"cls":"","label":"","value":"Regular Price : 14,000৳","href":null,"plain":true},{"cls":"","label":"","value":"Product ID : 387","href":null,"plain":true},{"cls":"product-stock out-of-stock","label":"Status:","value":"Out Of Stock","href":null,"plain":false},{"cls":"product-manufacturer","label":"Brands:","value":"Cambium Networks","href":"/cambium-network","plain":false},{"cls":"product-model","label":"Model:","value":"C024900C031A","href":null,"plain":false},{"cls":"product-sku","label":"SKU:","value":"In Pair","href":null,"plain":false}],"minimum":"","price":{"new":"12,000৳","old":"14,000৳","single":"","tax":"Ex Tax: 12,000৳","discounts":[]},"request":false,"askText":"","stepperHidden":false,"productId":"387","features":{"title":"Key Features","items":[{"h":"Frequency: 2.4 GHz: 2402 – 2472 MHz","c":[]},{"h":"Channel Width: 20 MHz or 40 MHz","c":[]},{"h":"Throughput: Up to 150 Mbps","c":[]},{"h":"Ethernet Interface: 100 BaseT, Cambium PoE","c":[]},{"h":"Ideal for CPE or short PTP link","c":[]},{"h":"Warranty: 1 Year","c":[]}],"noExpand":false},"tabs":[{"title":"Description","active":true,"cls":"tab-2","noExpand":false,"kind":"description","html":"\n                <h3 data-start=\"800\" data-end=\"1242\">Cambium Networks ePMP 1000 2.4GHz Integrated 150Mbps Radio with Built-in 12dBi Antenna</h3><p data-start=\"800\" data-end=\"1242\">The <strong data-start=\"804\" data-end=\"858\">Cambium Networks ePMP 1000 2.4GHz Integrated Radio</strong> with a <strong data-start=\"866\" data-end=\"893\">built-in 12 dBi antenna</strong> is designed to provide <strong data-start=\"917\" data-end=\"951\">reliable wireless connectivity</strong> in areas where the 5GHz spectrum is congested or unsuitable. Operating in the 2.4GHz band, this radio is ideal for <strong data-start=\"1067\" data-end=\"1095\">non-line-of-sight (NLOS)</strong> and <strong data-start=\"1100\" data-end=\"1121\">rural deployments</strong>, offering up to <strong data-start=\"1138\" data-end=\"1166\">150 Mbps real throughput</strong> for <strong data-start=\"1171\" data-end=\"1201\">Point-to-Multipoint (PTMP)</strong> and <strong data-start=\"1206\" data-end=\"1228\">short-distance PTP</strong> applications.</p>\n<p data-start=\"1244\" data-end=\"1520\">Equipped with <strong data-start=\"1258\" data-end=\"1285\">TDD GPS synchronization</strong>, <strong data-start=\"1287\" data-end=\"1321\">QoS for service prioritization</strong>, and <strong data-start=\"1327\" data-end=\"1354\">interference mitigation</strong>, the ePMP 1000 ensures a scalable and stable broadband network. Its compact, weather-resistant design is perfect for outdoor deployments in challenging environments.</p><h3 data-start=\"1527\" data-end=\"1550\"><strong data-start=\"1533\" data-end=\"1550\">Key Features:</strong></h3>\n<ul data-start=\"1551\" data-end=\"1905\"><li data-start=\"1551\" data-end=\"1587\">\n<p data-start=\"1553\" data-end=\"1587\">Frequency Range: 2.4 – 2.483 GHz</p>\n</li><li data-start=\"1588\" data-end=\"1629\">\n<p data-start=\"1590\" data-end=\"1629\">Integrated 12 dBi directional antenna</p>\n</li><li data-start=\"1630\" data-end=\"1666\">\n<p data-start=\"1632\" data-end=\"1666\">Up to 150 Mbps TCP/IP throughput</p>\n</li><li data-start=\"1667\" data-end=\"1731\">\n<p data-start=\"1669\" data-end=\"1731\">TDD synchronization with GPS (when used with a GPS-enabled AP)</p>\n</li><li data-start=\"1732\" data-end=\"1769\">\n<p data-start=\"1734\" data-end=\"1769\">Supports PTMP and short-range PTP</p>\n</li><li data-start=\"1770\" data-end=\"1828\">\n<p data-start=\"1772\" data-end=\"1828\">Strong performance in NLOS and high-interference areas</p>\n</li><li data-start=\"1829\" data-end=\"1866\">\n<p data-start=\"1831\" data-end=\"1866\">IP55-rated weatherproof enclosure</p>\n</li><li data-start=\"1867\" data-end=\"1905\">\n<p data-start=\"1869\" data-end=\"1905\">Easy mounting and alignment system</p></li></ul><h3 data-start=\"1912\" data-end=\"1938\"><strong data-start=\"1918\" data-end=\"1936\">Link Distance:</strong></h3>\n<ul data-start=\"1939\" data-end=\"2071\"><li data-start=\"1939\" data-end=\"2000\">\n<p data-start=\"1941\" data-end=\"2000\"><strong data-start=\"1941\" data-end=\"1961\">PTMP Link Range:</strong> Up to <strong data-start=\"1968\" data-end=\"1978\">3–6 km</strong> (NLOS and semi-LOS)</p>\n</li><li data-start=\"2001\" data-end=\"2071\">\n<p data-start=\"2003\" data-end=\"2071\"><strong data-start=\"2003\" data-end=\"2023\">Short PTP Range:</strong> Up to <strong data-start=\"2030\" data-end=\"2041\">8–10 km</strong> (with good LOS and alignment)</p></li></ul><h3 data-start=\"2078\" data-end=\"2112\"><strong data-start=\"2084\" data-end=\"2110\">Use Case Applications:</strong></h3>\n<ul data-start=\"2113\" data-end=\"2235\"><li data-start=\"2113\" data-end=\"2140\">\n<p data-start=\"2115\" data-end=\"2140\">Rural internet coverage</p>\n</li><li data-start=\"2141\" data-end=\"2170\">\n<p data-start=\"2143\" data-end=\"2170\">NLOS village connectivity</p>\n</li><li data-start=\"2171\" data-end=\"2192\">\n<p data-start=\"2173\" data-end=\"2192\">ISP last-mile CPE</p>\n</li><li data-start=\"2193\" data-end=\"2235\">\n<p data-start=\"2195\" data-end=\"2235\">Municipal and community Wi-Fi networks</p></li></ul>\n              "},{"title":"Product Table","active":false,"cls":"tab-4","noExpand":false,"kind":"compat","title2":"Product List","head":["","Price"],"rows":[{"name":"Cambium Networks ePMP 5GHz Force 300-25 High-Gain 500+ Mbps Radio with Integrated 25dBi Dish Antenna","href":"/cambium-networks-epmp-5ghz-force-300-25-high-gain-500-mbps-radio-with-integrated-25dbi-dish-antenna","now":"58,000৳","old":"60,00
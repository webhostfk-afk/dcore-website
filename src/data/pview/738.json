>USB Port for Data Transfer and Headset Support</li><li>5-Way Audio Conferencing</li><li>Electronic Hook Switch (EHS) Support</li><li>Advanced Security Protection with TLS and SRTP Encryption</li><li>Automated Provisioning and Device Management</li></ul>\n              "},{"title":"Product Table","active":false,"cls":"tab-4","noExpand":false,"kind":"compat","title2":"Product List","head":["","Price"],"rows":[{"name":"Dinstar C60SP Entry Level IP Phone with POE (Without Adapter)","href":"/dinstar-c60sp-entry-level-business-ip-phone","now":"3,400৳","old":"4,000৳","single":""},{"name":"SNOM C520 3-SIP PoE Black IP Conference Phone","href":"/snom-c520-3-sip-poe-black-ip-conference-phone","now":"33,000৳","old":"34,000৳","single":""},{"name":"Dinstar C60U Entry Level IP Phone with PoE and Adapter","href":"/dinstar-c60u-entry-level-ip-phone-with-poe-and-adapter","now":"","old":"","single":"3,700৳"},{"name":"DINSTAR C62UP Color Screen IP Phone with POE & Without Adapter","href":"/dinstar-c62up-color-screen-ip-phone-with-poe-and-without-adapter","now":"","old":"","single":"4,600৳"},{"name":"SNOM D305 4-SIP PoE Desk Black IP Phone Set without Adapter","href":"/snom-d305-4-sip-poe-desk-black-ip-phone-set-without-adapter","now":"","old":"","single":"4,290৳"},{"name":"SNOM D335 12-SIP PoE Desk Black IP Phone Set","href":"/snom-d335-12-sip-poe-desk-black-ip-phone-set","now":"","old":"","single":"13,800৳"},{"name":"SNOM D862 8-SIP PoE Desk Black IP Phone Set","href":"/snom-d862-8-sip-poe-desk-black-ip-phone-set","now":"","old":"","single":"22,900৳"},{"name":"SNOM D717 6-SIP PoE Desk Black IP Phone Set","href":"/snom-d717-6-sip-poe-desk-black-ip-phone-set","now":"","old":"","single":"9,500৳"},{"name":"SNOM D3 Expansion moduler for for SNOM D3xx Series","href":"/snom-d3-expansion-moduler-for-for-snom-d3xx-series","now":"","old":"","single":"9,400৳"},{"name":"Grandstream GRP2602P Basic HD IP Phone With Adapter","href":"/grandstream-grp2602p-basic-hd-ip-phone-with-adapter","now":"","o
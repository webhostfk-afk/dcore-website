talog/IBM/IBM%20X710%2001DA902/IBM-Intel-X710-DA2-P4-80x80.jpg.webp","alt":"IBM Intel X710-DA2 Dual Port 10GB SFP+ 01DA902 PCI Express x8 3.0 Ethernet Network Adapter","width":80,"height":80}],"labels":[{"out":false,"text":"-6 %"}],"banner":{"href":null,"image":{"src":"/image/cache/catalog/Slider%20Image/DCORE-Home-delivery-1040x200.jpg.webp","alt":"Home Delivery","width":0,"height":0}},"title":"IBM Intel X710-DA2 Dual Port 10GB SFP+ 01DA902 PCI Express x8 3.0 Ethernet Network Adapter","stats":[{"cls":"","label":"","value":"Special Price : 16,000৳","href":null,"plain":true},{"cls":"","label":"","value":"Regular Price : 17,000৳","href":null,"plain":true},{"cls":"","label":"","value":"Product ID : 401","href":null,"plain":true},{"cls":"product-stock in-stock","label":"Status:","value":"In Stock","href":null,"plain":false},{"cls":"product-manufacturer","label":"Brands:","value":"IBM","href":"/ibm","plain":false},{"cls":"product-model","label":"Model:","value":"01DA902","href":null,"plain":false}],"minimum":"","price":{"new":"16,000৳","old":"17,000৳","single":"","tax":"Ex Tax: 16,000৳","discounts":[]},"request":false,"askText":"","stepperHidden":false,"productId":"401","features":{"title":"Key Features","items":[{"h":"Intel X710-DA2 Dual-Ports 10Gbs SFP+","c":[]},{"h":"PCI Express 3.0 x8","c":[]},{"h":"Data Rate: 10 Gbit/s","c":[]},{"h":"Type of Expansion Slots: 2x SFP+","c":[]},{"h":"Warranty: 1 Year","c":[]}],"noExpand":false},"tabs":[{"title":"Description","active":true,"cls":"tab-2","noExpand":false,"kind":"description","html":"\n                <p data-start=\"792\" data-end=\"1143\">The <strong data-start=\"796\" data-end=\"841\">IBM Intel X710-DA2 (Part Number: 01DA902)</strong> is a <strong data-start=\"847\" data-end=\"887\">dual-port 10GbE SFP+ network adapter</strong>, designed for high-throughput, low-latency networking in enterprise environments. Powered by the <strong data-start=\"985\" data-end=\"1007\">Intel X710 chipset</strong>, this PCI Express Gen3 x8 card delivers reliable and efficient performance for cloud, virtualization, storage, and server applications.</p>\n<p data-start=\"1145\" data-end=\"1505\">With <strong data-start=\"1150\" data-end=\"1168\">two SFP+ ports</strong>, the X710-DA2 supports both <strong data-start=\"1197\" data-end=\"1221\">optical transceivers</strong> and <strong data-start=\"1226\" data-end=\"1256\">direct attach cables (DAC)</strong>, providing flexibility for various 10GbE networking setups. It includes support for <strong data-start=\"1341\" data-end=\"1351\">SR-IOV</strong>, <strong data-start=\"1353\" data-end=\"1362\">iSCSI</strong>, <strong data-start=\"1364\" data-end=\"1376\">PXE Boot</strong>, and advanced virtualization and load balancing features, making it ideal for modern data centers and high-density environments.</p><h3 data-start=\"1512\" data-end=\"1535\"><strong data-start=\"1518\" data-end=\"1535\">Key Features:</strong></h3>\n<ul data-start=\"1536\" data-end=\"2040\"><li data-start=\"1536\" data-end=\"1559\">\n<p data-start=\"1538\" data-end=\"1559\"><strong data-start=\"1538\" data-end=\"1548\">Model:</strong> X710-DA2</p>\n</li><li data-start=\"1560\" data-end=\"1583\">\n<p data-start=\"1562\" data-end=\"1583\"><strong data-start=\"1562\" data-end=\"1573\">IBM PN:</strong> 01DA902</p>\n</li><li data-start=\"1584\" data-end=\"1611\">\n<p data-start=\"1586\" data-end=\"1611\"><strong data-start=\"1586\" data-end=\"1598\">Chipset:</strong> Intel X710</p>\n</li><li data-start=\"1612\" data-end=\"1650\">\n<p data-start=\"1614\" data-end=\"1650\"><strong data-start=\"1614\" data-end=\"1628\">Interface:</strong> PCI Express Gen3 x8</p>\n</li><li data-start=\"1651\" data-end=\"1680\">\n<p data-start=\"1653\" data-end=\"1680\"><strong data-start=\"1653\" data-end=\"1663\">Ports:</strong> 2 x 10GbE SFP+</p>\n</li><li data-start=\"1681\" data-end=\"1734\">\n<p data-start=\"1683\" data-end=\"1734\"><strong data-start=\"1683\" data-end=\"1693\">Speed:</strong> Up to 10 Gbps per port (20 Gbps total)</p>\n</li><li data-start=\"1735\" data-end=\"1785\">\n<p data-start=\"1737\" data-end=\"1785\"><strong data-start=\"1737\" data-end=\"1749\">Cabling:</strong> Supports fiber optics or SFP+ DAC</p>\n</li><li data-start=\"1786\" data-end=\"1852\">\n<p data-start=\"1788\" data-end=\"1852\"><strong data-start=\"1788\" data-end=\"1804\">Form Factor:</strong> Low-profile and full-height brackets included</p>\n</li><li data-start=\"1853\" data-end=\"2040\">\n<p data-start=\"1855\" data-end=\"1879\"><strong data-start=\"1855\" data-end=\"1877\">Advanced Features:</strong></p>\n<ul data-start=\"1882\" data-end=\"2040\"><li data-start=\"1882\" data-end=\"1900\">\n<p data-start=\"1884\" data-end=\"1900\">SR-IOV support</p>\n</li><li data-start=\"1903\" data-end=\"1919\">\n<p data-start=\"1905\" data-end=\"1919\">Jumbo Frames</p>\n</li><li data-start=\"1922\" data-end=\"1944\">\n<p data-start=\"1924\" data-end=\"1944\">PXE and iSCSI Boot</p>\n</li><li data-start=\"1947\" data-end=\"1971\">\n<p data-start=\"1949\" data-end=\"1971\">VLAN and QoS support</p>\n</li><li data-start=\"1974\" data-end=\"2007\">\n<p data-start=\"1976\" data-end=\"2007\">DPDK, VXLAN, NVGRE Offloading</p>\n</li><li data-start=\"2010\" data-end=\"2040\">\n<p data-start=\"2012\" data-end=\"2040\">IEEE 802.1q, 802.3az, 802.1p</p></li></ul></li></ul><h3 data-start=\"2047\" data-end=\"2075\"><strong data-start=\"2053\" data-end=\"2073\">Compatible With:</strong></h3>\n<ul data-start=\"2076\" data-end=\"2207\"><li data-start=\"2076\" data-end=\"2123\">\n<p data-start=\"2078\" data-end=\"2123\">IBM System x and Lenovo ThinkSystem Servers</p>\n</li><li data-start=\"2124\" data-end=\"2167\">\n<p data-start=\"2126\" data-end=\"2167\">Other standard PCIe x8/x16 motherboards</p>\n</li><li data-start=\"2168\" data-end=\"2207\">\n<p data-start=\"2170\" data-end=\"2207\">Windows, Linux, VMware ESXi, and more</p></li></ul><h3 data-start=\"2214\" data-end=\"2236\"><strong data-start=\"2220\" data-end=\"2234\">Ideal For:</strong></h3>\n<ul data-start=\"2237\" data-end=\"2364\"><li data-start=\"2237\" data-end=\"2269\">\n<p data-start=\"2239\" data-end=\"2269\">High-Speed Server Networking</p>\n</li><li data-start=\"2270\" data-end=\"2303\">\n<p data-start=\"2272\" data-end=\"2303\">Data Centers &amp; Virtualization</p>\n</li><li data-start=\"2304\" data-end=\"2330\">\n<p data-start=\"2306\" data-end=\"2330\">iSCSI SAN Environments</p>\n</li><li data-start=\"2331\" data-end=\"2364\">\n<p data-start=\"2333\" data-end=\"2364\">Enterprise Cloud Infrastructure</p></li></ul>\n              "},{"title":"Product Table","active":false,"cls":"tab-4","noExpand":false,"kind":"compat","title2":"Product List","head":["","Price"],"rows":[{"name":"Mellanox CX4121A-ACAT CX4 10G/25G SFP28 Ethernet Network Card","href":"/mellanox-cx4121a-acat-cx4-10g25g-sfp28-ethernet-network-card","now":"18,000৳","old":"20,000৳","single":""},{"name":"Silicom 4x 10GE Quad Port PCI Express 3.0 SFP+ Network Adapter","href":"/%20silicom-4x-10ge-quad-port-pci-express-30-sfp-network-adapter","now":"18,000৳","old":"20,000৳","single":""},{"name":"Intel OT-ST7218 PCIe x8 X710-DA2 Dual 10GbE SFP+ PCIe 3.0 Network Adapter","href":"/intel-ot-st7218-pcie-x8-x710-da2-dual-10gbe-sfp-pcie-30-network-adapter","now":"18,000৳","old":"18,500৳","single":""},{"name":"IBM Broadcom BCM957800A 4-Port 2x10Gb SFP+ 2x1GbE RJ45 PCI Express 2.0 x8 Low-Profile Ethernet Network Adapter","href":"/ibm-broadcom-bcm957800a-4-port-2x10gb-sfp-2x1gbe-rj45-pci-express-20-x8-low-profile-ethernet-network-adapter","now":"9,000৳","old":"9,500৳","single":""},{"name":"Intel OT-ST727 PCIe X4 I350-T2 Dual RJ45 10/100/1000Mbps Gigabit Ethernet Card","href":"/%20intel-ot-st727-pcie-x4-i350-t2-dual-rj45-10-100-1000mbps-gigabit-ethernet-card","now":"2,700৳","old":"2,900৳","single":""},{"name":"IBM Broadcom BCM957800A 4-Port 2x10Gb SFP+ 2x1GbE RJ45 PCI Express 2.0 x8 High-Profile Ethernet Network Adapter","href":"/ibm-broadcom-bcm957800a-4-po
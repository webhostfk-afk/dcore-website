se.</p>\n              "},{"title":"Product Table","active":false,"cls":"tab-4","noExpand":false,"kind":"compat","title2":"Product List","head":["","Price"],"rows":[{"name":"BenQ RD240Q 24.1” 2K+ WQXGA Programming Monitor","href":"/benq-rd240q-241-2k-wqxga-programming-monitor","now":"54,000৳","old":"58,500৳","single":""}]},{"title":"Video","active":false,"cls":"tab-5","noExpand":true,"kind":"empty"},{"title":"Review","active":false,"cls":"tab-6","noExpand":false,"kind":"review"}],"side":{"title":"From Same Brand","items":[{"href":"/benq-rd240q-241-2k-wqxga-programming-monitor","image":{"src":"/image/cache/catalog/BenQ/RD240Q/RD240Q-500x500-3-100x100.jpg.webp","alt":"BenQ RD240Q 24.1” 2K+ WQXGA Programming Monitor","width":100,"height":100},"name":"BenQ RD240Q 24.1” 2K+ WQXGA Programming Monitor","now":"54,000৳","old":"58,500৳","single":"","tax":"Ex Tax:54,000৳","out":false}]},"tags":{"title":"Tags:","links":[{"href":"/index.php?route=product/search&tag=BenQ%20GW2283","text":"BenQ GW2283"},{"href":"/index.php?route=product/search&tag=21.5%20Inch%20Monitor","text":"21.5 Inch Monitor"},{"href":"/index.php?route=product/search&tag=Full%20HD%20Monitor","text":"Full HD Monitor"},{"href":"/index.php?route=product/search&tag=IPS%20Monitor","text":"IPS Monitor"},{"href":"/index.php?route=product/search&tag=Eye-Care%20Monitor","text":"Eye-Care Monitor"},{"href":"/index.php?route=product/search&tag=Low%20Blue%20Light%20Monitor","text":"Low Blue Light Monitor"},{"href":"/index.php?route=product/search&tag=Flicker-Free%20Display","text":"Flicker-Free Display"},{"href":"/index.php?route=product/search&tag=HDMI%20Monitor","text":"HDMI Monitor"},{"href":"/index.php?route=product/search&tag=Office%20Monitor","text":"Office Monitor"},{"href":"/index.php?route=product/search&tag=Home%20Monitor","text":"Home Monitor"},{"href":"/index.php?route=product/search&tag=LED%20Monitor","text":"LED Monitor"},{"href":"/index.php?route=product/search&tag=Slim%20Bezel%20Monitor","text":"Slim Bezel 
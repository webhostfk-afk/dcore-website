,"value":"Out Of Stock","href":null,"plain":false},{"cls":"product-manufacturer","label":"Brands:","value":"Cisco","href":"/cisco","plain":false},{"cls":"product-model","label":"Model:","value":"N540‑24Z8Q2C‑M","href":null,"plain":false},{"cls":"product-sku","label":"SKU:","value":"Condition: Used","href":null,"plain":false}],"minimum":"","price":{"new":"","old":"","single":"430,000৳","tax":"Ex Tax: 430,000৳","discounts":[]},"request":false,"askText":"","stepperHidden":false,"productId":"392","features":{"title":"Key Features","items":[{"h":"CPU: 4-Core 1.5Ghz x86","c":[]},{"h":"Memory: 32GB DRAM","c":[]},{"h":"Storage: 128GB storage","c":[]},{"h":"Interfaces: 24x 1GE/10GE; 8x 1GE/10GE/25GE; 2x 40GE/100GE","c":[]},{"h":"Performance: Up to 300 Mpps (up to 900 Gbps)","c":[]},{"h":"Management: Carrier-Class version of Cisco IOS XR software","c":[]},{"h":"FAN: Front-to-Back Airflow","c":[]},{"h":"Input Voltage: –48V DC (Approximately 250W)","c":[]},{"h":"Hot-Swappable DC Power Supply","c":[]},{"h":"Condition: Used","c":[]},{"h":"Warranty: 1 Year (Service Warranty)","c":[]}],"noExpand":false},"tabs":[{"title":"Description","active":true,"cls":"tab-2","noExpand":false,"kind":"description","html":"\n                <p data-start=\"213\" data-end=\"756\">The <strong data-start=\"217\" data-end=\"249\">Cisco NCS 540 N540‑24Z8Q2C‑M</strong> is a compact, high-performance, <strong data-start=\"282\" data-end=\"310\">carrier-grade 1RU router</strong> designed for next-generation metro aggregation and edge networks. Equipped with <strong data-start=\"391\" data-end=\"419\">24×10G SFP+, 8×25G SFP28</strong>, and <strong data-start=\"425\" data-end=\"442\">2×100G QSFP28</strong> interfaces, it delivers exceptional throughput and flexibility for service providers and data centers. With <strong data-start=\"551\" data-end=\"591\">dual hot-swappable DC power supplies</strong>, advanced routing protocols, and SDN/NFV-ready architecture, this router supports scalable IP/MPLS transport, seamless automation, and enhanced network resiliency.</p>\n<p data-start=\"758\" data-end=\"919\">Perfect for ISPs, telecom operators, and enterprise backbone deployments, the N540-24Z8Q2C-M ensures high availability and low latency in demanding environments.</p><p data-start=\"758\" data-end=\"919\"><br></p><h3 data-start=\"152\" data-end=\"171\"><strong data-start=\"158\" data-end=\"171\">Featured:</strong></h3>\n<ul data-start=\"173\" data-end=\"819\"><li data-start=\"173\" data-end=\"216\">\n<p data-start=\"175\" data-end=\"216\"><strong data-start=\"175\" data-end=\"185\">Model:</strong> Cisco NCS 540 N540‑24Z8Q2C‑M</p>\n</li><li data-start=\"217\" data-end=\"272\">\n<p data-start=\"219\" data-end=\"272\"><strong data-start=\"219\" data-end=\"235\">Form Factor:</strong> 1RU compact, carrier-grade chassis</p>\n</li><li data-start=\"273\" data-end=\"343\"><p data-start=\"275\" data-end=\"287\"><strong>Interfaces: 24x 1GE/10GE; 8x 1GE/10GE/25GE; 2x 40GE/100GE</strong></p></li><li data-start=\"344\" data-end=\"407\">\n<p data-start=\"346\" data-end=\"407\"><strong data-start=\"346\" data-end=\"361\">Throughput:</strong> Up to 300 Mpps (Million packets per second)</p>\n</li><li data-start=\"408\" data-end=\"465\">\n<p data-start=\"410\" data-end=\"465\"><strong data-start=\"410\" data-end=\"427\">Power Supply:</strong> Dual hot-swappable DC power modules</p>\n</li><li data-start=\"466\" data-end=\"535\">\n<p data-start=\"468\" data-end=\"535\"><strong data-start=\"468\" data-end=\"493\">Network Architecture:</strong> Supports IP/MPLS, Segment Routing, EVPN</p>\n</li><li data-start=\"536\" data-end=\"602\">\n<p data-start=\"538\" data-end=\"602\"><strong data-start=\"538\" data-end=\"560\">Advanced Features:</strong> Telemetry, SDN-ready, MACsec encryption</p>\n</li><li data-start=\"603\" data-end=\"684\">\n<p data-start=\"605\" data-end=\"684\"><strong data-start=\"605\" data-end=\"619\">Ideal For:</strong> Metro aggregation, ISP core, data center edge, mobile backhaul</p>\n</li><li data-start=\"685\" data-end=\"763\">\n<p data-start=\"687\" data-end=\"763\"><strong data-start=\"687\" data-end=\"709\">High Availability:</strong> Redundant power and fans, carrier-grade reliability</p>\n</li><li data-start=\"764\" data-end=\"819\">\n<p data-start=\"766\" data-end=\"819\"><strong data-start=\"766\" data-end=\"781\">Management:</strong> CLI, SNMP, NETCONF/YANG, Cisco IOS XR</p></li></ul><p data-start=\"758\" data-end=\"919\"><br></p><h3 data-start=\"110\" data-end=\"144\"><strong data-start=\"116\" data-end=\"144\">Bandwidth / Performance:</strong></h3>\n<ul data-start=\"146\" data-end=\"462\"><li data-start=\"146\" data-end=\"205\">\n<p data-start=\"148\" data-end=\"205\"><strong data-start=\"148\" data-end=\"178\">System Switching Capacity:</strong> <strong data-start=\"179\" data-end=\"203\">800 Gbps full duplex</strong></p>\n</li><li data-start=\"206\" data-end=\"272\">\n<p data-start=\"208\" data-end=\"272\"><strong data-start=\"208\" data-end=\"228\">Forwarding Rate:</strong> <strong data-start=\"229\" data-end=\"270\">300 million packets per second (Mpps)</strong></p>\n</li><li data-start=\"273\" data-end=\"462\">\n<p data-start=\"275\" data-end=\"309\"><strong data-start=\"275\" data-end=\"309\">Interface Bandwidth Breakdown:</strong></p>\n<ul data-start=\"312\" data-end=\"462\"><li data-start=\"312\" data-end=\"360\">\n<p data-start=\"314\" data-end=\"360\"><strong data-start=\"314\" data-end=\"337\">24 × 10G SFP+ ports</strong> → Up to <strong data-start=\"346\" data-end=\"358\">240 Gbps</strong></p>\n</li><li data-start=\"363\" data-end=\"411\">\n<p data-start=\"365\" data-end=\"411\"><strong data-start=\"365\" data-end=\"388\">8 × 25G SFP28 ports</strong> → Up to <strong data-start=\"397\" data-end=\"409\">200 Gbps</strong></p>\n</li><li data-start=\"414\" data-end=\"462\"><p data-start=\"416\" data-end=\"462\"><strong data-start=\"416\" data-end=\"441\">2 × 100G QSFP28 ports</strong> → Up to <strong data-start=\"450\" data-end=\"462\">200 Gbps</strong></p></li></ul></li></ul>\n              "},{"title":"Product Table","active":false,"cls":"tab-4","noExpand":false,"kind":"compat","title2":"Product List","head":["","Price"],"rows":[{"name":"Cisco ASR-920-24SZ-M Router","href":"/cisco-asr-920-24sz-m-router","now":"73,000৳","old":"75,000৳","single":""},{"name":"Mikrotik CCR2116-12G-4S+ 16-Core ARM CPU 4x 10G SFP+ Cloud Core Ethernet Router","href":"/mikrotik-ccr2116-12g-4s-16-core-arm-cpu-4x-10g-sfp-cloud-core-ethernet-router","now":"112,000৳","old":"119,000৳","single":""},{"name":"Juniper MX80 Universal Router","href":"/juniper-mx80-universal-router","now":"175,000৳","old":"180,000৳","single":""},{"name":"MikroTik CCR2004-1G-12S+2XS Cloud Core Router","href":"/mikrotik-ccr2004-1g-12s2xs-cloud-core-router","now":"67,000৳","old":"68,000৳","single":""},{"name":"Huawei NetEngine AR720 2x GE WAN Combo Ports 8x GE LAN Ports High-Performance Enterprise Router","href":"/%20huawei-netengine-ar720-2x-ge-wan-combo-ports-8x-ge-lan-ports-high-performance-enterprise-router","now":"85,000৳","old":"90,000৳","single":""},{"name":"Cisco C1111-8P Dual WAN Ethernet Integrated Services Router","href":"/cisco-c1111-8p-dual-wan-ethernet-integrated-services-router","now":"","old":"","single":"95,000৳"}]},{"title":"Video","active":false,"cls":"tab-5","noExpand":true,"kind":"empty"},{"title":"Review","active":false,"cls":"tab-6","noExpand":false,"kind":"review"}],"side":{"title":"From Same Brand","items":[{"href":"/cisco-n9k-c9372px-cisco-nexus-9300-switch-48x10g-sfp6x40g-qsfp","image":{"src":"/image/cache/catalog/Cisco%20N9K-C9372PX/Cisco%20%20N9K-C9372PX,%20Cisco%20Nexus%209300%20Switch,%2048x10G%20SFP+_6x40G%20QSFP+-100x100.jpg.webp","alt":"Cisco  N9K-C9372PX, Cisco Nexus 9300 Switch, 48x10G SFP+/6x40G QSFP+","width":100,"height":100},"name":"Cisco N9K-C9372PX, Cisco Nexus 9300 Switch, 48x10G SFP+/6x40G QSFP+","now":"75,000৳","old":"82,000৳","single":"","tax":"Ex Tax:75,000৳","out":false},{"href":"/cisc
":"Condition: Used","href":null,"plain":false}],"minimum":"","price":{"new":"","old":"","single":"700৳","tax":"Ex Tax: 700৳","discounts":[]},"request":false,"askText":"","stepperHidden":false,"productId":"102","features":{"title":"Key Features","items":[{"h":"Model: Cisco GLC-SX-MMD","c":[]},{"h":"Standard: 1000BASE-SX","c":[]},{"h":"Data Rate: 1Gbps (Gigabit Ethernet)","c":[]},{"h":"Wavelength: 850nm","c":[]},{"h":"Connector Type: LC Duplex","c":[]},{"h":"Condition: Used","c":[]},{"h":"Warranty: 1 Year","c":[]}],"noExpand":false},"tabs":[{"title":"Description","active":true,"cls":"tab-2","noExpand":false,"kind":"description","html":"\n                <h2><strong data-start=\"2\" data-end=\"57\">Cisco 1000BASE-SX Multimode SFP Module | GLC-SX-MMD</strong></h2><h3><strong data-start=\"64\" data-end=\"139\">High-Performance 1GE Short-Range Transceiver for Reliable Networking</strong></h3><p data-start=\"142\" data-end=\"511\">The <span data-start=\"146\" data-end=\"201\">Cisco 1000BASE-SX Multimode SFP Module (GLC-SX-MMD)</span> is a <span data-start=\"207\" data-end=\"253\">high-speed, energy-efficient, and reliable</span> optical transceiver designed for <span data-start=\"287\" data-end=\"336\">short-range Gigabit Ethernet (1GE) networking</span>. With an <span data-start=\"346\" data-end=\"366\">850nm wavelength</span> and <span data-start=\"371\" data-end=\"394\">LC duplex connector</span>, this <span data-start=\"401\" data-end=\"418\">hot-swappable</span> module ensures seamless <span data-start=\"443\" data-end=\"481\">data transmission up to 500 meters</span> over multimode fiber (MMF).</p><hr data-start=\"513\" data-end=\"516\"><h3><strong data-start=\"521\" data-end=\"551\">Key Features &amp; Benefits</strong></h3><p data-start=\"555\" data-end=\"1503\"><span data-start=\"557\" data-end=\"588\">1GE Short-Range Transceiver</span> – Supports <span data-start=\"600\" data-end=\"635\">Gigabit Ethernet (1Gbps) speeds</span> with the <span data-start=\"645\" data-end=\"669\">1000BASE-SX standard</span><br data-start=\"669\" data-end=\"672\"><span data-start=\"674\" data-end=\"713\">Multimode Fiber (MMF) Compatibility</span> – Optimized for <span data-start=\"730\" data-end=\"766\">short-distance data transmission</span><br data-start=\"766\" data-end=\"769\"><span data-start=\"771\" data-end=\"792\">Wavelength: 850nm</span> – Ensures <span data-start=\"803\" data-end=\"850\">efficient, high-speed optical communication</span><br data-start=\"850\" data-end=\"853\"><span data-start=\"855\" data-end=\"878\">LC Duplex Connector</span> – Provides <span data-start=\"890\" data-end=\"934\">secure, high-quality optical connections</span><br data-start=\"934\" data-end=\"937\"><span data-start=\"939\" data-end=\"976\">Transmission Distance: Up to 500m</span> – Reliable for <span data-start=\"992\" data-end=\"1034\">enterprise networking and data centers</span><br data-start=\"1034\" data-end=\"1037\"><span data-start=\"1039\" data-end=\"1083\">DOM (Digital Optical Monitoring) Support</span> – Enables <span data-start=\"1094\" data-end=\"1141\">real-time monitoring of optical performance</span><br data-start=\"1141\" data-end=\"1144\"><span data-start=\"1146\" data-end=\"1175\">Plug &amp; Play Compatibility</span> – Works with <span data-start=\"1189\" data-end=\"1247\">Cisco and other leading brands of routers and switches</span><br data-start=\"1247\" data-end=\"1250\" data-is-only-node=\"\"><span data-start=\"1252\" data-end=\"1269\">Hot-Swappable</span> – Easy installation and replacement without network downtime<br data-start=\"1330\" data-end=\"1333\"><span data-start=\"1335\" data-end=\"1362\">Universal Compatibility</span> – Compatible with <span data-start=\"1381\" data-end=\"1423\">all major networking brands' SFP ports</span><br></p><hr data-start=\"1505\" data-end=\"1508\"><h3><strong data-start=\"1513\" data-end=\"1544\">Technical Specifications</strong></h3><p data-start=\"1548\" data-end=\"2146\"><span data-start=\"155
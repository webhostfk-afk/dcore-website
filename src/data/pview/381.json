ge":{"src":"/image/cache/catalog/Slider%20Image/DCORE-Home-delivery-1040x200.jpg.webp","alt":"Home Delivery","width":0,"height":0}},"title":"Cambium Networks ePMP 5GHz Force 300-25 High-Gain 500+ Mbps Radio with Integrated 25dBi Dish Antenna","stats":[{"cls":"","label":"","value":"Special Price : 58,000৳","href":null,"plain":true},{"cls":"","label":"","value":"Regular Price : 60,000৳","href":null,"plain":true},{"cls":"","label":"","value":"Product ID : 381","href":null,"plain":true},{"cls":"product-stock in-stock","label":"Status:","value":"In Stock","href":null,"plain":false},{"cls":"product-manufacturer","label":"Brands:","value":"Cambium Networks","href":"/cambium-networks","plain":false},{"cls":"product-model","label":"Model:","value":"ePMP Force 300-25","href":null,"plain":false},{"cls":"product-sku","label":"SKU:","value":"In Pair","href":null,"plain":false}],"minimum":"","price":{"new":"58,000৳","old":"60,000৳","single":"","tax":"Ex Tax: 58,000৳","discounts":[]},"request":false,"askText":"","stepperHidden":false,"productId":"381","features":{"title":"Key Features","items":[{"h":"Frequency Range: 4910 - 5970 MHz","c":[]},{"h":"Channel Width: 20, 40, 80 MHz; 2x2 MIMO/OFDM Support","c":[]},{"h":"Max Data Rates: Up to 500 Mbps","c":[]},{"h":"1x Gigabit Ethernet","c":[]},{"h":"10/100/1000 BaseT, Compatible with Cambium PoE","c":[]},{"h":"Point-to-Point (PTP): 10 to 25 km","c":[]},{"h":"Warranty: 1 Year","c":[]}],"noExpand":false},"tabs":[{"title":"Description","active":true,"cls":"tab-2","noExpand":false,"kind":"description","html":"\n                <h2>Cambium Networks ePMP Force 300-25<br>\n      <span class=\"smallHeaderText\">High-Gain 802.11AC Wave 2 Solution - 500+ Mbps Peak Throughput</span></h2><p data-start=\"681\" data-end=\"1124\"><strong data-start=\"760\" data-end=\"798\"><br></strong></p><p data-start=\"681\" data-end=\"1124\"><strong data-start=\"760\" data-end=\"798\">Cambium Networks ePMP Force 300-25</strong>&nbsp;is a high-performance 5GHz radio solution designed for reliable long-distance connectivity. Featuring an <strong data-start=\"902\" data-end=\"935\">integrated 25dBi dish antenna</strong>, this device supports <strong data-start=\"958\" data-end=\"986\">over 500 Mbps throughput</strong>, making it ideal for <strong data-start=\"1008\" data-end=\"1032\">Point-to-Point (PTP)</strong> and <strong data-start=\"1037\" data-end=\"1067\">Point-to-Multipoint (PTMP)</strong> applications across rural and urban areas in Bangladesh.</p>\n<p data-start=\"1126\" data-end=\"1484\">Built on the <strong data-start=\"1139\" data-end=\"1158\">802.11ac Wave 2</strong> platform, the Force 300-25 offers advanced features like <strong data-start=\"1216\" data-end=\"1227\">MU-MIMO</strong>, <strong data-start=\"1229\" data-end=\"1244\">beamforming</strong>, and <strong data-start=\"1250\" data-end=\"1281\">high interference tolerance</strong> to ensure stable, high-speed connections even in noisy RF environments. Its rugged outdoor design and easy alignment features make it the go-to solution for ISPs, enterprises, and surveillance networks.</p>\n<p data-start=\"1486\" data-end=\"1503\"><strong data-start=\"1486\" data-end=\"1503\">Key Features:</strong></p>\n<ul data-start=\"1504\" data-end=\"1837\"><li data-start=\"1504\" data-end=\"1544\">\n<p data-start=\"1506\" data-end=\"1544\">Frequency: 5 GHz (licensed/unlicensed)</p>\n</li><li data-start=\"1545\" data-end=\"1589\">\n<p data-start=\"1547\" data-end=\"1589\">Integrated 25 dBi High-Gain Dish Antenna</p>\n</li><li data-start=\"1590\" data-end=\"1631\">\n<p data-start=\"1592\" data-end=\"1631\">Throughput: Over 500 Mbps real TCP/IP</p>\n</li><li data-start=\"1632\" data-end=\"1661\">\n<p data-start=\"1634\" data-end=\"1661\">Protocol: 802.11ac Wave 2</p>\n</li><li data-start=\"1662\" data-end=\"1699\">\n<p data-start=\"1664\" data-end=\"1699\">Supports TDD mode for scalability</p>\n</li><li data-start=\"1700\" data-end=\"1759\">\n<p data-start=\"1702\" data-end=\"1759\">Ideal for long-range wireless deployments in Bangladesh</p>\n</li><li data-start=\"1760\" data-end=\"1794\">\n<p data-start=\"1762\" data-end=\"1794\">IP55-rated weatherproof design</p>\n</li><li data-start=\"1795\" data-end=\"1837\"><p data-start=\"1797\" data-end=\"1837\">Easy installation with alignment tools</p></li></ul><p data-start=\"1486\" data-end=\"1503\"><br></p><h3 data-start=\"158\" data-end=\"198\"><span data-start=\"165\" data-end=\"198\" style=\"font-weight: normal; font-size: 16px;\">Link Distance of Force 300-25:</span></h3>\n<ul data-start=\"200\" data-end=\"443\"><li data-start=\"200\" data-end=\"307\">\n<p data-start=\"202\" data-end=\"307\"><strong data-start=\"202\" data-end=\"228\">Maximum Link Distance:</strong> Up to <strong data-start=\"235\" data-end=\"253\">30+ kilometers</strong> (line-of-sight, clear Fresnel zone, ideal conditions)</p>\n</li><li data-start=\"308\" data-end=\"443\">\n<p data-start=\"310\" data-end=\"340\"><strong data-start=\"310\" data-end=\"338\">Typical Stable Distance:</strong></p>\n<ul data-start=\"343\" data-end=\"443\"><li data-start=\"343\" data-end=\"381\">\n<p data-start=\"345\" data-end=\"381\"><strong data-start=\"345\" data-end=\"370\">Point-to-Point (PTP):</strong> 10–25 km</p>\n</li><li data-start=\"384\" data-end=\"443\">\n<p data-start=\"386\" data-end=\"443\"><strong data-start=\"386\" data-end=\"435\">Point-to-Multipoint (PTMP Subscriber Module):</strong> 5–15 km</p></li></ul></li></ul><h3 data-start=\"450\" data-end=\"484\"><span style=\"font-size: 20px;\"><br></span></h3><h3 data-start=\"450\" data-end=\"484\"><span style=\"font-size: 20px;\">Factors Affecting Distance:</span></h3>\n<ul data-start=\"485\" data-end=\"723\"><li data-start=\"485\" data-end=\"539\">\n<p data-start=\"487\" data-end=\"539\">Line-of-sight (no trees, buildings, or obstructions)</p>\n</li><li data-start=\"540\" data-end=\"588\">\n<p data-start=\"542\" data-end=\"588\">Interference level (especially in urban areas)</p>\n</li><li data-start=\"589\" data-end=\"622\">\n<p data-start=\"591\" data-end=\"622\">Antenna alignment and elevation</p>\n</li><li data-start=\"623\" data-end=\"664\">\n<p data-start=\"625\" data-end=\"664\">Channel width and modulation rate (MCS)</p>\n</li><li data-start=\"665\" data-end=\"723\">\n<p data-start=\"667\" data-end=\"723\">Weather conditions (especially rain fade for long links)</p></li></ul><p data-start=\"1486\" data-end=\"1503\"><br></p><p data-start=\"1486\" data-end=\"1503\"><strong data-start=\"1486\" data-end=\"1503\"><br></strong></p><p data-start=\"1486\" data-end=\"1503\"><strong data-start=\"1486\" data-end=\"1503\"><br></strong></p><br>\n              "},{"title":"Product Table","active":false,"cls":"tab-4","noExpand":false,"kind":"compat","title2":"Product List","head":["","Price"],"rows":[{"name":"Ubiquiti LBE-M5-23 airMAX LiteBeam M5 100+ Mbps Wireless Radio Link","href":"/ubiquiti-lbe-m5-23-airmax-litebeam-m5-150-mbps-wireless-radio-link","now":"18,000৳","old":"20,000৳","single":""},{"name":"Ubiquiti airMAX NanoStation M5 NSM5 5GHz 150+ Mbps 16dBi CPE Wireless Radio Link","href":"/ubiquiti-airmax-nanostation-m5-nsm5-5ghz-150-mbps-16dbi-cpe-wireless-radio-link","now":"24,000৳","old":"26,000৳","single":""},{"name":"Cambium Networks ePMP 5GHz ePMP Force 300-16 Radio 500Mbps with 16dBi Integrated Antenna","href":"/cambium-networks-epmp-5ghz-epmp-force-300-16-radio-500mbps-with-16dbi-integrated-antenna","now":"46,000৳","old":"47,000৳","single":""},{"name":"Cambium Networks 5GHz PTP 550 Connectorized 1.4 Gbps Point to Point Backhaul Radio Link","href":"/cambium-networks-5ghz-ptp-550-connectorized-14-gbps-point-to-point-backhaul-radio-link","now":"175,000৳","old":"180,000৳","single":""},{"name":"Cambium Networks ePMP 5GHz Force 300-25L 400Mbps Radio with Integrated 25dBi Dish Antenna","href":"/cambium-networks-epmp-5ghz-force-300-25l-400mbps-radio-with-integrated-25dbi-dish-antenna","now":"48,000৳","old":"50,000৳","single":""},{"name":"Cambi
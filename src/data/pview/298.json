"height":0}},"title":"DeepCool AG300 Single Tower CPU Cooler","stats":[{"cls":"","label":"","value":"Regular Price : 1,900৳","href":null,"plain":true},{"cls":"","label":"","value":"Product ID : 298","href":null,"plain":true},{"cls":"product-stock in-stock","label":"Status:","value":"In Stock","href":null,"plain":false},{"cls":"product-manufacturer","label":"Brands:","value":"DeepCool","href":"/deepcool","plain":false},{"cls":"product-model","label":"Model:","value":"GAMMAXX AG300","href":null,"plain":false}],"minimum":"","price":{"new":"","old":"","single":"1,900৳","tax":"Ex Tax: 1,900৳","discounts":[]},"request":false,"askText":"","stepperHidden":false,"productId":"298","features":{"title":"Key Features","items":[{"h":"Model: GAMMAXX AG300","c":[]},{"h":"Air Pressure: 2.89","c":[]},{"h":"Supported CPU: LGA 1150,LGA 1151,LGA 1155,LGA 1156,LGA1200,LGA 1700,Socket AM5,AM4","c":[]},{"h":"Fan Speed: 500 - 3050rpm","c":[]},{"h":"Warranty: 1 year","c":[]}],"noExpand":false},"tabs":[{"title":"Description","active":true,"cls":"tab-2","noExpand":false,"kind":"description","html":"\n                <h2>DeepCool AG300 Single Tower CPU Cooler – High-Performance Cooling for Mainstream CPUs</h2><p>Experience reliable and efficient cooling with the DeepCool AG300 Single Tower CPU Cooler, expertly designed to deliver optimal thermal performance for Intel and AMD processors. Featuring a compact single-tower heatsink design, the AG300 is equipped with a high-efficiency 120mm PWM fan and three direct-touch copper heat pipes for fast and effective heat dissipation.</p><p>Built with performance and quiet operation in mind, the AG300 maintains low temperatures and minimal noise levels, even during heavy gaming or multitasking. Its slim profile ensures excellent RAM compatibility and easy installation in most mid-tower and micro-ATX cases. The universal mounting kit supports a wide range of CPU sockets, including Intel LGA1700/1200/115x and AMD AM5/AM4, making it a versatile cooling solution for new builds or upgrades.</p><h3>Key Features:</h3><ul><li>Advanced single-tower air cooling with high-density aluminum fins</li><li>120mm PWM fan for smart, quiet, and efficient airflow control</li><li>3 direct-contact copper heat pipes for fast heat transfer</li><li>Compact design for wide case and RAM clearance compatibility</li><li>Easy installation with multi-platform mounting support (Intel &amp; AMD)</li></ul>\n              "},{"title":"Product Table","active":false,"cls":"tab-4","noExpand":false,"kind":"compat","title2":"Product List","head":["","Price"],"rows":[{"name":"Deepcool GAMMAXX AG500 ARGB Cpu Cooler","href":"/deepcool-gammaxx-ag500-argb-cpu-cooler","now":"2,900৳","old":"3,500৳","single":""},{"name":"DeepCool LS720S ZERO DARK 360mm Liquid CPU Cooler","href":"/deepcool-ls720s-zero-dark-360mm-liquid-cpu-cooler","now":"11,700৳","old":"12,500৳","single":""},{"name":"Deepcool AK500 120mm Single Tower CPU Cooler","href":"/deepcool-ak500-120mm-single-tower-cpu-cooler","now":"5,200৳","old":"5,320৳","single":""},{"name":"Deepcool AK500 WH 120mm Single Tower CPU Cooler","href":"/deepcool-ak500-wh-120mm-single-tower-cpu-cooler","now":"5,500৳","old":"6,320৳","single":""},{"name":"DeepCool AG400 PLUS 120mm CPU cooler","href":"/deepcool-ag400-plus-120mm-cpu-cooler","now":"","old":"","single":"2,800৳"},{"name":"DeepCool AG400 LED 120mm CPU Cooler","href":"/deepcool-ag400-led-120mm-cpu-cooler","now":"","old":"","single":"2,150৳"},{"name":"DeepCool AK400 BK High Performance CPU Air Cooler","href":"/deepcool-ak400-bk-high-performance-cpu-air-cooler","now":"","old":"","single":"3,100৳"},{"name":"Jungle Leopard A200 Plus CPU Cooling FAN","href":"/jungle-leopard-a200-plus-cpu-cooling-fan","now":"","old":"","single":"850৳"},{"name":"DeepCool AG400 BK ARGB 120mm Single Tower CPU Cooler","href":"/deepcool-ag400-bk-argb-120mm-single-tower-cpu-cooler","now":"","old":"","single":"3,000৳"},{"name":"DeepCool GAMMAXX AG400 WH ARGB 120mm CPU Cooler","href":"/deepcool-gamma
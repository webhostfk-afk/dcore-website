plain":true},{"cls":"","label":"","value":"Regular Price : 17,000৳","href":null,"plain":true},{"cls":"","label":"","value":"Product ID : 398","href":null,"plain":true},{"cls":"product-stock in-stock","label":"Status:","value":"In Stock","href":null,"plain":false},{"cls":"product-manufacturer","label":"Brands:","value":"HPE","href":"/index.php?route=product/manufacturer/info&manufacturer_id=89","plain":false},{"cls":"product-model","label":"Model:","value":"HPE 562SFP+","href":null,"plain":false}],"minimum":"","price":{"new":"15,000৳","old":"17,000৳","single":"","tax":"Ex Tax: 15,000৳","discounts":[]},"request":false,"askText":"","stepperHidden":false,"productId":"398","features":{"title":"Key Features","items":[{"h":"Controller: Intel X710","c":[]},{"h":"Interface: PCI Express 3.0 x8","c":[]},{"h":"Ports: 2 x 10GbE SFP+","c":[]},{"h":"Interface Speed: 10 Gbps per port (20 Gbps aggregate)","c":[]},{"h":"Warranty: 1 Year","c":[]}],"noExpand":false},"tabs":[{"title":"Description","active":true,"cls":"tab-2","noExpand":false,"kind":"description","html":"\n                <h2 id=\"hpeit_specification_title\" style=\"font-weight:600\">HPE&nbsp;Intel X710‑DA2 Ethernet 10Gb 2‑port SFP+ Adapter</h2><p data-start=\"754\" data-end=\"1077\">The <strong data-start=\"758\" data-end=\"773\">HPE 562SFP+</strong> is a <strong data-start=\"779\" data-end=\"822\">dual-port 10Gb Ethernet network adapter</strong> featuring the reliable <strong data-start=\"846\" data-end=\"871\">Intel X710 controller</strong>, designed for use with HPE ProLiant Gen9 and Gen10 servers. This adapter supports <strong data-start=\"954\" data-end=\"977\">PCI Express Gen3 x8</strong>, delivering high bandwidth and low latency for cloud, virtualization, and data center environments.</p>\n<p data-start=\"1079\" data-end=\"1378\">Equipped with <strong data-start=\"1093\" data-end=\"1111\">two SFP+ ports</strong>, the 562SFP+ enables high-speed fiber or direct attach copper (DAC) connectivity. The adapter supports advanced networking features such as <strong data-start=\"1252\" data-end=\"1262\">SR-IOV</strong>, <strong data-start=\"1264\" data-end=\"1278\">iSCSI boot</strong>, and <strong data-start=\"1284\" data-end=\"1303\">VMware NetQueue</strong>, making it ideal for virtualized workloads and enterprise infrastructures.</p><h3 data-start=\"1385\" data-end=\"1408\"><strong data-start=\"1391\" data-end=\"1408\">Key Features:</strong></h3>\n<ul data-start=\"1409\" data-end=\"1939\"><li data-start=\"1409\" data-end=\"1435\">\n<p data-start=\"1411\" data-end=\"1435\"><strong data-start=\"1411\" data-end=\"1421\">Model:</strong> HPE 562SFP+</p>\n</li><li data-start=\"1436\" data-end=\"1466\">\n<p data-start=\"1438\" data-end=\"1466\"><strong data-start=\"1438\" data-end=\"1453\">Controller:</strong> Intel X710</p>\n</li><li data-start=\"1467\" data-end=\"1504\">\n<p data-start=\"1469\" data-end=\"1504\"><strong data-start=\"1469\" data-end=\"1483\">Interface:</strong> PCI Express 3.0 x8</p>\n</li><li data-start=\"1505\" data-end=\"1534\">\n<p data-start=\"1507\" data-end=\"1534\"><strong data-start=\"1507\" data-end=\"1517\">Ports:</strong> 2 x 10GbE SFP+</p>\n</li><li data-start=\"1535\" data-end=\"1586\">\n<p data-start=\"1537\" data-end=\"1586\"><strong data-start=\"1537\" data-end=\"1547\">Speed:</strong> 10 Gbps per port (20 Gbps aggregate)</p>\n</li><li data-start=\"1587\" data-end=\"1647\">\n<p data-start=\"1589\" data-end=\"1647\"><strong data-start=\"1589\" data-end=\"1608\">Connector Type:</strong> SFP+ (supports fiber and DAC cables)</p>\n</li><li data-start=\"1648\" data-end=\"1816\">\n<p data-start=\"1650\" data-end=\"1674\"><strong data-start=\"1650\" data-end=\"1672\">Advanced Features:</strong></p>\n<ul data-start=\"1677\" data-end=\"1816\"><li data-start=\"1677\" data-end=\"1720\">\n<p data-start=\"1679\" data-end=\"1720\">SR-IOV (Single Root I/O Virtualization)</p>\n</li><li data-start=\"1723\" data-end=\"1749\">\n<p data-start=\"1725\" data-end=\"1749\">iSCSI and FCoE support</p>\n</li><li data-start=\"1752\" data-end=\"1787\">\n<p data-start=\"1754\" data-end=\"1787\">VLAN tagging and load balancing</p>\n</li><li data-start=\"1790\" data-end=\"1816\">\n<p data-start=\"1792\" data-end=\"1816\">Jumbo frames, PXE boot</p>\n</li></ul>\n</li><li data-start=\"1817\" data-end=\"1874\">\n<p data-start=\"1819\" data-end=\"1874\"><strong data-start=\"1819\" data-end=\"1837\">Compatibility:</strong> Windows Server, Linux, VMware ESXi</p>\n</li><li data-start=\"1875\" data-end=\"1939\">\n<p data-start=\"1877\" data-end=\"1939\"><strong data-start=\"1877\" data-end=\"1893\">Form Factor:</strong> Low-profile and full-height brackets included</p></li></ul><h3 data-start=\"1946\" data-end=\"1968\"><strong data-start=\"1952\" data-end=\"1966\">Use Cases:</strong></h3>\n<ul data-start=\"1969\" data-end=\"2151\"><li data-start=\"1969\" data-end=\"2003\">\n<p data-start=\"1971\" data-end=\"2003\">HPE ProLiant DL and ML servers</p>\n</li><li data-start=\"2004\" data-end=\"2031\">\n<p data-start=\"2006\" data-end=\"2031\">Enterprise data centers</p>\n</li><li data-start=\"2032\" data-end=\"2068\">\n<p data-start=\"2034\" data-end=\"2068\">High-throughput storage networks</p>\n</li><li data-start=\"2069\" data-end=\"2107\">\n<p data-start=\"2071\" data-end=\"2107\">Virtualization and cloud platforms</p>\n</li><li data-start=\"2108\" data-end=\"2151\">\n<p data-start=\"2110\" data-end=\"2151\">High-speed server-to-server communication</p></li></ul>\n              "},{"title":"Product Table","active":false,"cls":"tab-4","noExpand":false,"kind":"compat","title2":"Product List","head":["","Price"],"rows":[{"name":"Mellanox CX4121A-ACAT CX4 10G/25G SFP28 Ethernet Network Card","href":"/mellanox-cx4121a-acat-cx4-10g25g-sfp28-ethernet-network-card","now":"18,000৳","old":"20,000৳","single":""},{"name":"Silicom 4x 10GE Quad Port PCI Express 3.0 SFP+ Network Adapter","href":"/%20silicom-4x-10ge-quad-port-pci-express-30-sfp-network-adapter","now":"1
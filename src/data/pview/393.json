lain":true},{"cls":"product-stock in-stock","label":"Status:","value":"In Stock","href":null,"plain":false},{"cls":"product-manufacturer","label":"Brands:","value":"Ubiquiti","href":"/ubiquiti","plain":false},{"cls":"product-model","label":"Model:","value":"NSM5","href":null,"plain":false},{"cls":"product-sku","label":"SKU:","value":"In Pair","href":null,"plain":false}],"minimum":"","price":{"new":"24,000৳","old":"26,000৳","single":"","tax":"Ex Tax: 24,000৳","discounts":[]},"request":false,"askText":"","stepperHidden":false,"productId":"393","features":{"title":"Key Features","items":[{"h":"Frequency: 5.1 – 5.8 GHz","c":[]},{"h":"Integrated 16 dBi high-gain panel antenna","c":[]},{"h":"Range: 5km Up to 15+ km (with line-of-sight)","c":[]},{"h":"2x 10/100 MbE RJ45 ports","c":[]},{"h":"24V, 0.5A PoE adapter (Included)","c":[]},{"h":"Pole-mount (Kit included)","c":[]},{"h":"Warranty: 1 Year","c":[]}],"noExpand":false},"tabs":[{"title":"Description","active":true,"cls":"tab-2","noExpand":false,"kind":"description","html":"\n                <p data-start=\"744\" data-end=\"1107\">The <strong data-start=\"748\" data-end=\"789\">Ubiquiti airMAX NanoStation M5 (NSM5)</strong> is a reliable and affordable <strong data-start=\"819\" data-end=\"869\">5GHz outdoor CPE (Customer Premises Equipment)</strong> designed for long-range wireless broadband connectivity. It features a <strong data-start=\"941\" data-end=\"973\">16 dBi dual-polarity antenna</strong>, <strong data-start=\"975\" data-end=\"1011\">150+ Mbps real TCP/IP throughput</strong>, and Ubiquiti’s proven <strong data-start=\"1035\" data-end=\"1059\">airMAX TDMA protocol</strong> for enhanced performance in noisy environments.</p>\n<p data-start=\"1109\" data-end=\"1372\">Whether you need a <strong data-start=\"1128\" data-end=\"1147\">wireless bridge</strong> or <strong data-start=\"1151\" data-end=\"1192\">point-to-multipoint subscriber module</strong>, the NSM5 is perfect for <strong data-start=\"1218\" data-end=\"1226\">ISPs</strong>, <strong data-start=\"1228\" data-end=\"1249\">remote monitoring</strong>, <strong data-start=\"1251\" data-end=\"1259\">VoIP</strong>, or <strong data-start=\"1264\" data-end=\"1283\">Wi-Fi extension</strong> across open distances. It combines a sleek form factor with professional-grade features.</p><p data-start=\"1109\" data-end=\"1372\"><br></p><h3 data-start=\"1379\" data-end=\"1402\"><strong data-start=\"1385\" data-end=\"1402\">Key Features:</strong></h3>\n<ul data-start=\"1403\" data-end=\"1727\"><li data-start=\"1403\" data-end=\"1431\">\n<p data-start=\"1405\" data-end=\"1431\">Frequency: 5.1 – 5.8 GHz</p>\n</li><li data-start=\"1432\" data-end=\"1477\">\n<p data-start=\"1434\" data-end=\"1477\">Integrated 16 dBi high-gain panel antenna</p>\n</li><li data-start=\"1478\" data-end=\"1515\">\n<p data-start=\"1480\" data-end=\"1515\">Throughput: 150+ Mbps real TCP/IP</p>\n</li><li data-start=\"1516\" data-end=\"1560\">\n<p data-start=\"1518\" data-end=\"1560\">Range: Up to 15+ km (with line-of-sight)</p>\n</li><li data-start=\"1561\" data-end=\"1616\">\n<p data-start=\"1563\" data-end=\"1616\">airMAX TDMA protocol for collision-free performance</p>\n</li><li data-start=\"1617\" data-end=\"1646\">\n<p data-start=\"1619\" data-end=\"1646\">Passive PoE support (24V)</p>\n</li><li data-start=\"1647\" data-end=\"1685\">\n<p data-start=\"1649\" data-end=\"1685\">Compact and weatherproof enclosure</p>\n</li><li data-start=\"1686\" data-end=\"1727\">\n<p data-start=\"1688\" data-end=\"1727\">Easy setup via Ubiquiti airOS interface</p></li></ul><p data-start=\"1109\" data-end=\"1372\"><br></p><h3 data-start=\"1734\" data-end=\"1760\"><strong data-start=\"1740\" data-end=\"1758\">Link Distance:</strong></h3>\n<ul data-start=\"1761\" data-end=\"1863\"><li data-start=\"1761\" data-end=\"1807\">\n<p data-start=\"1763\" data-end=\"1807\"><strong data-start=\"1763\" data-end=\"1788\">Point-to-Point (PTP):</strong> Up to <strong data-start=\"1795\" data-end=\"1805\">15 km+</strong></p>\n</li><li data-start=\"1808\" data-end=\"1863\">\n<p data-start=\"1810\" data-end=\"1863\"><strong data-start=\"1810\" data-end=\"1841\">Point-to-Multipoint (PTMP):</strong> 5–10 km (as CPE unit)</p></li></ul><p data-start=\"1109\" data-end=\"1372\"><br></p><h3 data-start=\"1870\" data-end=\"1892\"><strong data-start=\"1876\" data-end=\"1890\">Ideal For:</strong></h3>\n<ul data-start=\"1893\" data-end=\"2075\"><li data-start=\"1893\" data-end=\"1924\">\n<p data-start=\"1895\" data-end=\"1924\">ISP subscriber connectivity</p>\n</li><li data-start=\"1925\" data-end=\"1957\">\n<p data-start=\"1927\" data-end=\"1957\">Rural broadband distribution</p>\n</li><li data-start=\"1958\" data-end=\"1995\">\n<p data-start=\"1960\" data-end=\"1995\">Wi-Fi extension between buildings</p>\n</li><li data-start=\"1996\" data-end=\"2034\">\n<p data-start=\"1998\" data-end=\"2034\">CCTV &amp; IP camera wireless backhaul</p>\n</li><li data-start=\"2035\" data-end=\"2075\"><p data-start=\"2037\" data-end=\"2075\">Educational or industrial campus links</p></li></ul>\n              "},{"title":"Product Table","active":false,"cls":"tab-4","noExpand":false,"kind":"compat","title2":"Product List","head":["","Price"],"rows":[{"name":"Cambium Networks ePMP 5GHz Force 300-25 High-Gain 500+ Mbps Radio with Integrated 25dBi Dish Antenna","href":"/cambium-networks-epmp-5ghz-force-300-25-high-gain-500-mbps-radio-with-integrated-25dbi-dish-antenna","now":"58,000৳","old":"60,000৳","single":""},{"name":"Ubiquiti LBE-M5-23 airMAX LiteBeam M5 100+ Mbps Wireless Radio Link","href":"/ubiquiti-lbe-m5-23-airmax-litebeam-m5-150-mbps-wireless-radio-link","now":"18,000৳","old":"20,000৳","single":""},{"name":"Cambium Networks ePMP 5GHz ePMP Force 300-16 Radio 500Mbps with 16dBi Integrated Antenna","href":"/cambium-networks-epmp-5ghz-epmp-force-300-16-radio-500mbps-with-16dbi-integrated-antenna","now":"46,000৳","old":"47,000৳","single":""},{"name":"Cambium Networks 5GHz PTP 550 Con